---
// What the induced voltage actually carries: amplitude, period, and harmonic
// structure, in one figure. The waveform and the bar chart are drawn from
// the same amplitudes array, so the shape on the left and the bars on the
// right are provably the same signal rather than two illustrations that
// happen to agree.
import { harmonicSeriesCycle } from "../../lib/audio/analysis";
import { waveformPath, type Viewport } from "../../lib/draw/svgTrace";

interface Props {
  amplitudes?: number[];
  ariaLabel?: string;
}

const { amplitudes = [1, 0.5, 0.3, 0.15], ariaLabel } = Astro.props;

const viewport: Viewport & { padding: number } = { width: 480, height: 200, padding: 16 };
const samples = harmonicSeriesCycle(amplitudes, 240);
const path = waveformPath(samples, viewport);
const maxAmplitude = Math.max(...amplitudes);
const mid = viewport.height / 2;

const label =
  ariaLabel ??
  "An induced-voltage waveform with its amplitude and period marked, next to a bar chart showing the signal is built from a fundamental frequency plus progressively weaker harmonics.";
---

<div class="sa-diagram" role="img" aria-label={label}>
  <svg class="sa-wave" viewBox={`0 0 ${viewport.width} ${viewport.height}`}>
    <line x1="0" y1={mid} x2={viewport.width} y2={mid} class="sa-axis" />
    <path d={path} class="sa-path" fill="none" />

    <line x1="22" y1="14" x2="22" y2={viewport.height - 14} class="sa-brace" />
    <line x1="16" y1="14" x2="28" y2="14" class="sa-brace" />
    <line x1="16" y1={viewport.height - 14} x2="28" y2={viewport.height - 14} class="sa-brace" />
    <text x="36" y={mid} class="sa-label">Amplitude</text>

    <line
      x1={viewport.padding}
      y1={viewport.height - 10}
      x2={viewport.width - viewport.padding}
      y2={viewport.height - 10}
      class="sa-brace"
    />
    <text x={viewport.width / 2} y={viewport.height - 16} class="sa-label sa-label--center">
      Period &middot; T = 1/f
    </text>
  </svg>

  <div class="sa-bars">
    {
      amplitudes.map((a, i) => (
        <div class="sa-bar-col">
          <div class="sa-bar" style={`height:${Math.max((a / maxAmplitude) * 100, 4)}%`} />
          <span class="sa-bar-tick">{i === 0 ? "f₀" : `${i + 1}f₀`}</span>
        </div>
      ))
    }
  </div>
</div>

<style>
  .sa-diagram {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 0.8fr);
    gap: 2.5rem;
    align-items: center;
    width: 100%;
    max-width: 44rem;
    margin-inline: auto;
  }

  .sa-wave {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .sa-axis {
    stroke: var(--t-line);
    stroke-width: 1;
  }

  .sa-path {
    stroke: var(--t-signal);
    stroke-width: 2;
  }

  .sa-brace {
    stroke: var(--t-line-strong);
    stroke-width: 1;
  }

  .sa-label {
    fill: var(--t-mute);
    font-family: var(--t-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .sa-label--center {
    text-anchor: middle;
  }

  .sa-bars {
    display: flex;
    align-items: flex-end;
    gap: 0.85rem;
    height: 9rem;
  }

  .sa-bar-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    gap: 0.5rem;
    flex: 1;
    height: 100%;
  }

  .sa-bar {
    width: 100%;
    max-width: 1.4rem;
    background: var(--t-copper);
    border-radius: 1px;
  }

  .sa-bar-tick {
    font-family: var(--t-mono);
    font-size: 0.75rem;
    color: var(--t-mute);
  }
</style>
