---
// The course's causal spine, reused twice per week: once as a map of where
// the page is going, once directly above the interactive lab as the bridge
// from theory into practice. It always reduces to the same four-part shape —
// physical mechanism → signal transformation → waveform/spectral consequence
// → audible consequence — so the first link is coloured as a physical cause
// and the last as what a listener hears, with the transformation between
// them left neutral.
interface Props {
  compact?: boolean;
  steps?: string[];
}

const {
  compact = false,
  steps = [
    "Physical mechanism",
    "Signal transformation",
    "Waveform / spectral consequence",
    "Audible consequence",
  ],
} = Astro.props;
---

<ol
  class:list={["causal-chain", { "causal-chain--compact": compact }]}
  role="list"
  aria-label={`Causal chain: ${steps.join(" leads to ")}.`}
>
  {
    steps.map((step, index) => (
      <li class="causal-step">
        <span
          class:list={[
            "t-label",
            "causal-step-label",
            index === 0 && "t-label--copper",
            index === steps.length - 1 && "t-label--signal",
          ]}
        >
          {step}
        </span>
        {index < steps.length - 1 && (
          <span class="causal-arrow" aria-hidden="true">
            &rarr;
          </span>
        )}
      </li>
    ))
  }
</ol>

<style>
  .causal-chain {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    row-gap: 0.6rem;
    margin: 0;
    padding-block: 0.85rem;
    padding-inline: 0;
    list-style: none;
    border-block: 1px solid var(--t-line);
  }

  .causal-chain--compact {
    padding-block: 0.55rem;
  }

  .causal-step {
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }

  .causal-step-label {
    white-space: nowrap;
  }

  .causal-arrow {
    font-family: var(--t-mono);
    color: var(--t-edge);
    margin-inline: 0.7rem;
  }

  @media (width < 40rem) {
    .causal-chain {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }

    .causal-step {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.3rem;
    }

    .causal-arrow {
      display: none;
    }
  }
</style>
