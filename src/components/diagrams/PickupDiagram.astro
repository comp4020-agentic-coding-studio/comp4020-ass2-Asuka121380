---
// Week 3 "See It": a real photograph answering "what physically exists"
// (a humbucker and two single-coils, labelled) plus a simple two-frame
// sketch answering "what changes dynamically" (flux through the coil as the
// string moves) — deliberately two different artefacts for two different
// questions, per CLAUDE.md's "real structure teaches better as a real
// photograph" guidance and the brief's instruction not to make one crude
// diagram answer both "what exists" and "what changes."
import { Image } from "astro:assets";
import pickupPhoto from "../../assets/images/week3-pickup-anatomy.jpg";

const LABELS = [
  { text: "STRING", x: 30, y: 6 },
  { text: "POLE PIECE", x: 47, y: 30 },
  { text: "COIL", x: 78, y: 46 },
  { text: "MAGNET", x: 20, y: 78 },
];
---

<div class="pickup-diagrams">
  <figure class="pickup-card pickup-card--photo bench-module">
    <div class="pickup-photo-wrap">
      <Image
        src={pickupPhoto}
        alt="Photograph of a humbucker and two single-coil guitar pickups mounted on a shared pickguard, showing pole pieces, coil bobbins and mounting hardware."
        widths={[380, 640]}
        sizes="(max-width: 40rem) 90vw, 24rem"
        format="avif"
        class="pickup-photo"
      />
      <ul class="pickup-callouts" aria-hidden="true">
        {LABELS.map((l) => <li style={`--x:${l.x}%; --y:${l.y}%;`}>{l.text}</li>)}
      </ul>
    </div>
    <figcaption>
      <span class="pickup-label">Pickup structure</span>
      <span class="pickup-description">A permanent magnet, one or more pole pieces, and a coil of wire, positioned under a string that itself needs to be ferromagnetic to interact with the field. Photo: Feitscherg, public domain.</span>
    </figcaption>
  </figure>

  <figure class="pickup-card bench-module">
    <svg viewBox="0 0 200 100" role="img" aria-label="Two frames showing the string at rest and displaced toward the pole piece: as the string moves, the magnetic flux through the coil changes, and that change induces a voltage.">
      <g>
        <line x1="6" y1="20" x2="86" y2="20" class="string" />
        <line x1="6" y1="20" x2="86" y2="20" class="string-rest" stroke-dasharray="2 3" />
        <rect x="38" y="34" width="16" height="26" class="pole-piece" />
        <rect x="24" y="64" width="44" height="14" class="magnet" />
        <text x="46" y="10" class="part-label" text-anchor="middle">string at rest</text>
      </g>
      <svg x="90" y="0" width="20" height="100" viewBox="0 0 20 100">
        <line x1="2" y1="50" x2="18" y2="50" class="wire" />
        <path d="M 11 44 L 18 50 L 11 56" fill="none" class="wire" />
      </svg>
      <g transform="translate(114, 0)">
        <line x1="6" y1="20" x2="86" y2="20" class="string-rest" stroke-dasharray="2 3" />
        <line x1="6" y1="30" x2="86" y2="30" class="string" />
        <rect x="38" y="34" width="16" height="26" class="pole-piece" />
        <rect x="24" y="64" width="44" height="14" class="magnet" />
        <path d="M 30 30 Q 46 40 62 30" class="flux-line" fill="none" />
        <text x="46" y="10" class="part-label" text-anchor="middle">string displaced</text>
      </g>
    </svg>
    <figcaption>
      <span class="pickup-label">Motion induces a voltage</span>
      <span class="pickup-description">As the string moves nearer to and further from the pole piece, the magnetic flux through the coil changes — a changing flux is what induces the electrical signal, not the string's position by itself.</span>
    </figcaption>
  </figure>
</div>

<style>
  .pickup-diagrams {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 1rem;
  }

  .pickup-card {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .pickup-card svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .pickup-photo-wrap {
    position: relative;
  }

  .pickup-photo {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--at-border);
  }

  .pickup-callouts {
    position: absolute;
    inset: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pickup-callouts li {
    position: absolute;
    left: var(--x);
    top: var(--y);
    font-family: var(--bench-readout, var(--at-font-mono));
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    color: var(--bench-phosphor, var(--at-accent));
    background: color-mix(in oklch, var(--at-bg) 75%, transparent);
    padding: 0.1rem 0.35rem;
    white-space: nowrap;
  }

  .string {
    stroke: var(--bench-phosphor, var(--at-accent));
    stroke-width: 2;
  }

  .string-rest {
    stroke: var(--at-text-secondary);
    stroke-width: 1;
    fill: none;
  }

  .pole-piece {
    fill: var(--at-bg);
    stroke: var(--at-text-secondary);
    stroke-width: 1.5;
  }

  .magnet {
    fill: var(--at-bg-alt);
    stroke: var(--at-text-secondary);
    stroke-width: 1.5;
  }

  .wire {
    stroke: var(--at-text-secondary);
    stroke-width: 1.5;
    fill: none;
  }

  .flux-line {
    stroke: var(--at-accent);
    stroke-width: 1.5;
    stroke-dasharray: 2 2;
  }

  .part-label {
    font-family: var(--bench-readout, var(--at-font-mono));
    font-size: 6px;
    fill: var(--at-text-secondary);
  }

  figcaption {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .pickup-label {
    font-family: var(--bench-readout, var(--at-font-mono));
    font-size: var(--at-font-size-sm);
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--at-text);
  }

  .pickup-description {
    font-size: var(--at-font-size-xs);
    color: var(--at-text-secondary);
    line-height: 1.35;
  }
</style>
