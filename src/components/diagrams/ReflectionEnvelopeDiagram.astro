---
// A reusable amplitude-vs-time stem plot: a direct-sound spike at t=0,
// then a scatter of reflections decaying over time. The same shape stands
// in for two related ideas depending on where it's used — "early
// reflections plus a dense decaying tail" (natural reverb) and "an
// impulse response" (a measured system response) — both are, in outline,
// exactly this: a direct arrival followed by a decaying scatter of
// repeats. `synthesiseReflections` is the same function the live DelayLab
// imports for its reverb envelope panel, so the shape shown here and the
// shape the lab draws for the same room-size/decay values are identical.
import { synthesiseReflections } from "../../lib/audio/delay";

interface Props {
  roomSize: number;
  decay: number;
  label: string;
  ariaLabel: string;
}

const { roomSize, decay, label, ariaLabel } = Astro.props;

const PLOT_LEFT = 24;
const PLOT_RIGHT = 292;
const PLOT_TOP = 12;
const PLOT_BOTTOM = 88;
const MAX_TIME_SECONDS = 1.8;

function xForTime(t: number): number {
  return PLOT_LEFT + (Math.min(t, MAX_TIME_SECONDS) / MAX_TIME_SECONDS) * (PLOT_RIGHT - PLOT_LEFT);
}

function yForAmplitude(a: number): number {
  return PLOT_BOTTOM - Math.min(Math.abs(a), 1) * (PLOT_BOTTOM - PLOT_TOP);
}

const events = synthesiseReflections(roomSize, decay);
const direct = events[0];
const rest = events.slice(1);
const ticks = [0, 0.5, 1, 1.5];
---

<div class="reflection-envelope bench-module" role="img" aria-label={ariaLabel}>
  <svg viewBox={`0 0 300 110`}>
    <line x1={PLOT_LEFT} y1={PLOT_BOTTOM} x2={PLOT_RIGHT} y2={PLOT_BOTTOM} class="axis-line" />
    {ticks.map((t) => (
      <>
        <line x1={xForTime(t)} y1={PLOT_BOTTOM} x2={xForTime(t)} y2={PLOT_BOTTOM + 3} class="tick-line" />
        <text x={xForTime(t)} y={PLOT_BOTTOM + 11} class="time-tick" text-anchor="middle">{t}s</text>
      </>
    ))}
    <line x1={xForTime(direct.timeSeconds)} y1={PLOT_BOTTOM} x2={xForTime(direct.timeSeconds)} y2={yForAmplitude(direct.amplitude)} class="direct-stem" />
    {rest.map((event) => (
      <line
        x1={xForTime(event.timeSeconds)}
        y1={PLOT_BOTTOM}
        x2={xForTime(event.timeSeconds)}
        y2={yForAmplitude(event.amplitude)}
        class="reflection-stem"
      />
    ))}
  </svg>
  <figcaption>{label}</figcaption>
</div>

<style>
  .reflection-envelope svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .axis-line {
    stroke: var(--at-text-secondary);
    stroke-width: 1;
  }

  .tick-line {
    stroke: var(--at-text-secondary);
    stroke-width: 1;
  }

  .time-tick {
    font-family: var(--bench-readout, var(--at-font-mono));
    font-size: 6px;
    fill: var(--at-text-secondary);
  }

  .direct-stem {
    stroke: var(--bench-input-trace, var(--at-accent));
    stroke-width: 2;
  }

  .reflection-stem {
    stroke: var(--bench-phosphor, var(--at-accent));
    stroke-width: 1.25;
    opacity: 0.85;
  }

  figcaption {
    margin-top: 0.5rem;
    font-size: var(--at-font-size-xs);
    color: var(--at-text-secondary);
    text-align: center;
  }
</style>
