---
// Week 11 "See It": a guitar loudspeaker's physical construction, and a
// simple two-frame sketch of why current direction sets motion direction.
//
// The construction itself is a real physical object, so it is a sourced
// cutaway diagram rather than a hand-drawn
// approximation of what a speaker looks like. The current-direction sketch
// is the opposite case: it shows a functional relationship (current sense
// in, force direction out), not any real object's appearance, so it stays a
// small conceptual line diagram.
import { Image } from "astro:assets";
import loudspeakerCutaway from "../../assets/images/week11-loudspeaker-cutaway.svg";

const PARTS = [
  { n: 1, name: "Surround", note: "the flexible rim that lets the cone move" },
  { n: 2, name: "Cone", note: "the surface that pushes the surrounding air" },
  { n: 3, name: "Dust cap", note: "covers the coil/pole gap at the centre" },
  { n: 4, name: "Spider", note: "a rear suspension that keeps the coil centred" },
  { n: 5, name: "Magnet", note: "supplies the fixed magnetic field" },
  { n: 6, name: "Voice coil", note: "carries the amplifier's current, sitting in the magnet's gap" },
  { n: 7, name: "Basket", note: "the rigid frame everything else is mounted to" },
];
---

<div class="speaker-diagrams">
  <figure class="speaker-photo">
    <div class="speaker-photo-frame">
      <Image
        src={loudspeakerCutaway}
        alt="Labelled cutaway diagram of a dynamic loudspeaker, numbered 1 to 7 from the outer rim to the frame: surround, cone, dust cap, spider, magnet, voice coil, basket."
        class="speaker-photo-image"
      />
    </div>
    <figcaption class="speaker-caption">
      <span class="t-label speaker-label">Loudspeaker structure</span>
      <ol class="speaker-legend">
        {PARTS.map((part) => (
          <li>
            <span class="legend-num" aria-hidden="true">{part.n}</span>
            <span class="legend-name">{part.name}</span> — {part.note}
          </li>
        ))}
      </ol>
      <p class="t-label speaker-credit">Diagram: Maksim (original), Harkonnen2 (SVG) · CC BY-SA 3.0 / GFDL, via Wikimedia Commons</p>
    </figcaption>
  </figure>

  <figure class="speaker-card">
    <svg viewBox="0 0 200 100" role="img" aria-label="Two frames showing that reversing the direction of current through the voice coil reverses the direction the cone moves: current one way pushes the cone forward, current the other way pulls it back.">
      <g>
        <rect x="10" y="38" width="16" height="24" class="coil" />
        <path d="M 8 30 L 20 30" class="wire" />
        <path d="M 16 26 L 20 30 L 16 34" class="wire" fill="none" />
        <path d="M 30 50 L 62 38" class="cone" />
        <path d="M 30 50 L 62 62" class="cone" />
        <text x="18" y="20" class="part-label" text-anchor="middle">current →</text>
        <text x="46" y="80" class="part-label" text-anchor="middle">cone pushed forward</text>
      </g>
      <g transform="translate(100, 0)">
        <rect x="10" y="38" width="16" height="24" class="coil" />
        <path d="M 20 30 L 8 30" class="wire" />
        <path d="M 12 26 L 8 30 L 12 34" class="wire" fill="none" />
        <path d="M 30 50 L 58 42" class="cone" />
        <path d="M 30 50 L 58 58" class="cone" />
        <text x="18" y="20" class="part-label" text-anchor="middle">current ←</text>
        <text x="44" y="80" class="part-label" text-anchor="middle">cone pulled back</text>
      </g>
    </svg>
    <figcaption>
      <span class="t-label speaker-label">Current direction sets motion direction</span>
      <span class="speaker-description">Reversing the current through the voice coil reverses the force on it, so the cone moves the other way — this back-and-forth motion, driven directly by the amplifier's electrical signal, is what produces sound.</span>
    </figcaption>
  </figure>
</div>

<style>
  .speaker-diagrams {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: clamp(1.5rem, 3vw, 2.5rem);
    align-items: start;
  }

  .speaker-photo,
  .speaker-card {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .speaker-photo-frame {
    background: #fff;
    border-radius: 4px;
    padding: 0.75rem;
  }

  .speaker-photo-image {
    display: block;
    width: 100%;
    height: auto;
  }

  .speaker-card svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .speaker-legend {
    display: grid;
    gap: 0.3rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--t-small);
    color: var(--t-dim);
    line-height: 1.4;
  }

  .legend-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.1em;
    height: 1.1em;
    margin-inline-end: 0.35em;
    border-radius: 50%;
    background: var(--t-raised);
    color: var(--t-mute);
    font-family: var(--t-mono);
    font-size: 0.75em;
  }

  .legend-name {
    color: var(--t-paper);
  }

  .speaker-credit {
    margin-top: 0.2rem;
  }

  .coil {
    fill: none;
    stroke: var(--t-signal);
    stroke-width: 1.5;
  }

  .cone {
    stroke: var(--t-copper);
    stroke-width: 1.5;
    fill: none;
  }

  .wire {
    stroke: var(--t-signal);
    stroke-width: 1.5;
    fill: none;
  }

  .part-label {
    font-family: var(--t-mono);
    font-size: 6px;
    fill: var(--t-mute);
  }

  figcaption {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .speaker-description {
    font-size: var(--t-small);
    color: var(--t-dim);
    line-height: 1.4;
  }
</style>
