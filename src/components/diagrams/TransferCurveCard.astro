---
// One topology's transfer curve (input amplitude -> output amplitude) plus
// a short caption. Purely presentational — the curve data is computed by
// the caller with the same `buildClippingCurve` the lab and audio engine
// use, so this card can never disagree with what the lab actually does.
import { transferCurvePath, type Viewport } from "../../lib/draw/svgTrace";

interface Props {
  label: string;
  description: string;
  curve: ArrayLike<number>;
}

const { label, description, curve } = Astro.props;
const viewport: Viewport = { width: 120, height: 120, padding: 12 };
const padding = viewport.padding ?? 0;
const path = transferCurvePath(curve, viewport);
---

<figure class="curve-card">
  <svg viewBox={`0 0 ${viewport.width} ${viewport.height}`} role="img" aria-label={`Transfer curve: ${label}. ${description}`}>
    <line x1={padding} y1={viewport.height / 2} x2={viewport.width - padding} y2={viewport.height / 2} class="axis" />
    <line x1={viewport.width / 2} y1={padding} x2={viewport.width / 2} y2={viewport.height - padding} class="axis" />
    <path d={path} class="curve" fill="none" />
  </svg>
  <figcaption>
    <span class="curve-label">{label}</span>
    <span class="curve-description">{description}</span>
  </figcaption>
</figure>

<style>
  .curve-card {
    margin: 0;
    padding-top: 0.75rem;
    border-top: 2px solid var(--t-signal);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .curve-card svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .axis {
    stroke: var(--t-line);
    stroke-width: 1;
  }

  .curve {
    stroke: var(--t-signal);
    stroke-width: 2;
  }

  figcaption {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .curve-label {
    font-family: var(--t-mono);
    font-size: var(--t-label);
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--t-paper);
  }

  .curve-description {
    font-size: var(--t-label);
    color: var(--t-dim);
    line-height: 1.35;
  }
</style>
