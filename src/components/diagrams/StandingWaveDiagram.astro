---
// Week 2 "See It": an idealised string, fixed at both ends, in each of its
// first four vibration modes — the fundamental and the next three
// harmonics — with node/antinode markers, plus a small open-vs-fretted
// length comparison. All static: one representative snapshot per mode, not
// an animation, since the teaching point is the shape of each mode, not its
// time behaviour (Week 2's "Attack and Decay" note is handled in prose).
import { waveformPath, type Viewport } from "../../lib/draw/svgTrace";

interface Mode {
  n: number;
  label: string;
}

const modes: Mode[] = [
  { n: 1, label: "Fundamental (f₁)" },
  { n: 2, label: "2nd harmonic (2f₁)" },
  { n: 3, label: "3rd harmonic (3f₁)" },
  { n: 4, label: "4th harmonic (4f₁)" },
];

const viewport: Viewport = { width: 240, height: 48, padding: 4 };
const sampleCount = 128;

function modeShape(n: number): Float64Array {
  const samples = new Float64Array(sampleCount);
  for (let i = 0; i < sampleCount; i++) {
    samples[i] = Math.sin((n * Math.PI * i) / (sampleCount - 1));
  }
  return samples;
}

function nodeXs(n: number): number[] {
  const { width, padding = 0 } = viewport;
  const inner = width - padding * 2;
  const xs: number[] = [];
  for (let k = 0; k <= n; k++) xs.push(padding + (k / n) * inner);
  return xs;
}
---

<div class="standing-wave bench-module">
  <div class="modes" role="img" aria-label="The first four vibration modes of a string fixed at both ends: the fundamental and its next three harmonics, each shown as a snapshot of its mode shape with nodes marked where the string doesn't move.">
    {modes.map((mode) => (
      <div class="mode-row">
        <span class="mode-label">{mode.label}</span>
        <svg viewBox={`0 0 ${viewport.width} ${viewport.height}`} aria-hidden="true">
          <line x1={viewport.padding} y1={viewport.height / 2} x2={viewport.width - (viewport.padding ?? 0)} y2={viewport.height / 2} class="rest-line" />
          <path d={waveformPath(modeShape(mode.n), viewport)} class="mode-trace" fill="none" />
          {nodeXs(mode.n).map((x) => (
            <circle cx={x} cy={viewport.height / 2} r="2.5" class="node-dot" />
          ))}
        </svg>
      </div>
    ))}
  </div>
  <p class="bench-scope-note">Dots mark nodes — points that stay still in that mode. Every mode is pinned to zero at both ends (the bridge and the fret or nut), same as Week 2's boundary condition; only the pattern in between differs.</p>

  <div class="length-compare" role="img" aria-label="Fretting the string at the twelfth fret roughly halves its vibrating length, which roughly doubles its fundamental frequency — one octave higher.">
    <div class="length-row">
      <span class="mode-label">Open string — length L</span>
      <svg viewBox="0 0 240 16" aria-hidden="true">
        <line x1="4" y1="8" x2="236" y2="8" class="string-line" />
        <line x1="4" y1="2" x2="4" y2="14" class="end-mark" />
        <line x1="236" y1="2" x2="236" y2="14" class="end-mark" />
      </svg>
    </div>
    <div class="length-row">
      <span class="mode-label">Fretted at the 12th fret — length ≈ L/2, frequency ≈ 2 × f₁</span>
      <svg viewBox="0 0 240 16" aria-hidden="true">
        <line x1="4" y1="8" x2="120" y2="8" class="string-line" />
        <line x1="120" y1="8" x2="236" y2="8" class="string-line string-line--damped" />
        <line x1="4" y1="2" x2="4" y2="14" class="end-mark" />
        <line x1="120" y1="2" x2="120" y2="14" class="end-mark end-mark--fret" />
        <line x1="236" y1="2" x2="236" y2="14" class="end-mark" />
      </svg>
    </div>
  </div>
</div>

<style>
  .standing-wave {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .modes {
    display: grid;
    gap: 0.6rem;
  }

  .mode-row,
  .length-row {
    display: grid;
    grid-template-columns: 9rem 1fr;
    align-items: center;
    gap: 0.75rem;
  }

  .mode-label {
    font-family: var(--bench-readout, var(--at-font-mono));
    font-size: var(--at-font-size-xs);
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--at-text-secondary);
  }

  .mode-row svg,
  .length-row svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .rest-line {
    stroke: var(--bench-grid, var(--at-border));
    stroke-width: 1;
    stroke-dasharray: 2 3;
  }

  .mode-trace {
    stroke: var(--bench-phosphor, var(--at-accent));
    stroke-width: 2;
  }

  .node-dot {
    fill: var(--at-text-secondary);
  }

  .length-compare {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding-top: 0.75rem;
    border-top: 1px dashed var(--at-border);
  }

  .string-line {
    stroke: var(--bench-phosphor, var(--at-accent));
    stroke-width: 2;
  }

  .string-line--damped {
    stroke: var(--at-text-secondary);
    stroke-dasharray: 3 3;
    opacity: 0.6;
  }

  .end-mark {
    stroke: var(--at-text-secondary);
    stroke-width: 1.5;
  }

  .end-mark--fret {
    stroke: var(--at-accent);
    stroke-width: 2;
  }

  @media (max-width: 640px) {
    .mode-row,
    .length-row {
      grid-template-columns: 1fr;
      gap: 0.3rem;
    }
  }
</style>
