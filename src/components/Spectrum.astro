---
interface Props {
  id: string;
  label: string;
  magnitudes: number[];
  fillVar?: string;
  grid?: boolean;
  highlightIndices?: number[];
  highlightFillVar?: string;
}

const {
  id,
  label,
  magnitudes,
  fillVar = "--at-accent",
  grid = true,
  highlightIndices = [],
  highlightFillVar = "--at-error",
} = Astro.props;
---

<figure class="spectrum">
  <canvas id={id} width="640" height="200" role="img" aria-label={label}></canvas>
  <figcaption>{label}</figcaption>
</figure>

<script define:vars={{ id, magnitudes, fillVar, grid, highlightIndices, highlightFillVar }}>
  import("../lib/draw/spectrum.ts").then(({ drawSpectrum }) => {
    const canvas = document.getElementById(id);
    const ctx = canvas?.getContext("2d");
    if (!ctx || !canvas) return;
    const styles = getComputedStyle(canvas);
    const fill = styles.getPropertyValue(fillVar).trim();
    const highlightFill = highlightIndices.length ? styles.getPropertyValue(highlightFillVar).trim() : undefined;
    const gridColor = grid ? styles.getPropertyValue("--at-border").trim() : undefined;
    const labelColor = grid ? styles.getPropertyValue("--at-text-secondary").trim() : undefined;
    drawSpectrum(ctx, magnitudes, {
      fill: fill || "#e2b13c",
      background: "transparent",
      gridColor,
      labelColor,
      highlightIndices,
      highlightFill,
    });
  });
</script>

<style>
  .spectrum {
    margin: 0;
  }

  canvas {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--at-border);
    border-radius: var(--at-border-radius);
    background: var(--at-bg-alt);
  }

  figcaption {
    margin-top: 0.35rem;
    font-size: var(--at-font-size-xs);
    color: var(--at-text-secondary);
  }
</style>
