---
interface Props {
  id: string;
  label: string;
  magnitudes: number[];
  fillVar?: string;
  grid?: boolean;
  highlightIndices?: number[];
  highlightFillVar?: string;
}

const {
  id,
  label,
  magnitudes,
  fillVar = "--at-accent",
  grid = true,
  highlightIndices = [],
  highlightFillVar = "--at-error",
} = Astro.props;
---

<figure class="spectrum">
  <canvas
    id={id}
    width="640"
    height="200"
    role="img"
    aria-label={label}
    data-spectrum-display
    data-magnitudes={JSON.stringify(magnitudes)}
    data-fill-var={fillVar}
    data-grid={grid}
    data-highlight-indices={JSON.stringify(highlightIndices)}
    data-highlight-fill-var={highlightFillVar}
  ></canvas>
  <figcaption>{label}</figcaption>
</figure>

<script>
  // See Waveform.astro for why this reads props from data-* attributes
  // instead of define:vars + a dynamic import(): define:vars forces a
  // non-module inline script, and a relative import() inside one resolves
  // against the page's URL rather than this file's, 404ing on every
  // /lectures/week-NN/ page.
  import { drawSpectrum } from "../lib/draw/spectrum";

  for (const canvas of document.querySelectorAll<HTMLCanvasElement>("canvas[data-spectrum-display]")) {
    if (canvas.dataset.spectrumInitialized) continue;
    canvas.dataset.spectrumInitialized = "true";
    const ctx = canvas.getContext("2d");
    if (!ctx) continue;
    const magnitudes = JSON.parse(canvas.dataset.magnitudes ?? "[]");
    const fillVar = canvas.dataset.fillVar || "--at-accent";
    const grid = canvas.dataset.grid === "true";
    const highlightIndices = JSON.parse(canvas.dataset.highlightIndices ?? "[]");
    const highlightFillVar = canvas.dataset.highlightFillVar || "--at-error";
    const styles = getComputedStyle(canvas);
    const fill = styles.getPropertyValue(fillVar).trim();
    const highlightFill = highlightIndices.length ? styles.getPropertyValue(highlightFillVar).trim() : undefined;
    const gridColor = grid ? styles.getPropertyValue("--at-border").trim() : undefined;
    const labelColor = grid ? styles.getPropertyValue("--at-text-secondary").trim() : undefined;
    drawSpectrum(ctx, magnitudes, {
      fill: fill || "#e2b13c",
      background: "transparent",
      gridColor,
      labelColor,
      highlightIndices,
      highlightFill,
    });
  }
</script>

<style>
  .spectrum {
    margin: 0;
  }

  canvas {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--at-border);
    border-radius: var(--at-border-radius);
    background: var(--at-bg-alt);
  }

  figcaption {
    margin-top: 0.35rem;
    font-size: var(--at-font-size-xs);
    color: var(--at-text-secondary);
  }

  /* TONE pages have no soft-panel chrome to round a display into — flatten
     the theme's default corner radius there without touching legacy pages. */
  :global([data-tone]) canvas {
    border-radius: 0;
  }

  :global([data-tone]) figcaption {
    font-family: var(--t-mono);
    font-size: var(--t-label);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
</style>
