---
interface Props {
  id: string;
  label: string;
  magnitudes: number[];
  fillVar?: string;
}

const { id, label, magnitudes, fillVar = "--at-accent" } = Astro.props;
---

<figure class="spectrum">
  <canvas id={id} width="480" height="120" role="img" aria-label={label}></canvas>
  <figcaption>{label}</figcaption>
</figure>

<script define:vars={{ id, magnitudes, fillVar }}>
  import("../lib/draw/spectrum.ts").then(({ drawSpectrum }) => {
    const canvas = document.getElementById(id);
    const ctx = canvas?.getContext("2d");
    if (!ctx) return;
    const fill = getComputedStyle(document.documentElement).getPropertyValue(fillVar).trim();
    drawSpectrum(ctx, magnitudes, { fill: fill || "#e2b13c", background: "transparent" });
  });
</script>

<style>
  .spectrum {
    margin: 0;
  }

  canvas {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--at-border);
    border-radius: var(--at-border-radius);
    background: var(--at-bg-alt);
  }

  figcaption {
    margin-top: 0.35rem;
    font-size: var(--at-font-size-xs);
    color: var(--at-text-secondary);
  }
</style>
