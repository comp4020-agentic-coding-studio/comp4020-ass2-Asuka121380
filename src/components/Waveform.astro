---
interface Props {
  id: string;
  label: string;
  samples: number[];
  strokeVar?: string;
  grid?: boolean;
}

const { id, label, samples, strokeVar = "--at-accent", grid = true } = Astro.props;
---

<figure class="waveform">
  <canvas
    id={id}
    width="640"
    height="200"
    role="img"
    aria-label={label}
    data-waveform-display
    data-samples={JSON.stringify(samples)}
    data-stroke-var={strokeVar}
    data-grid={grid}
  ></canvas>
  <figcaption>{label}</figcaption>
</figure>

<script>
  // A plain top-level static import (not define:vars + dynamic import()):
  // define:vars forces this script to render as a non-module inline
  // script, and a relative `import("../lib/draw/waveform.ts")` inside one
  // resolves against the *page's* URL, not this file's — on every
  // /lectures/week-NN/ page that 404s. Reading props back from data-*
  // attributes keeps this a real, Vite-bundled module like every other
  // script in this codebase. Astro dedupes this script to one instance per
  // page even though <Waveform> is used multiple times, so it queries for
  // every canvas rather than assuming a single one.
  import { drawWaveform } from "../lib/draw/waveform";

  for (const canvas of document.querySelectorAll<HTMLCanvasElement>("canvas[data-waveform-display]")) {
    if (canvas.dataset.waveformInitialized) continue;
    canvas.dataset.waveformInitialized = "true";
    const ctx = canvas.getContext("2d");
    if (!ctx) continue;
    const samples = JSON.parse(canvas.dataset.samples ?? "[]");
    const strokeVar = canvas.dataset.strokeVar || "--at-accent";
    const grid = canvas.dataset.grid === "true";
    const styles = getComputedStyle(canvas);
    const stroke = styles.getPropertyValue(strokeVar).trim();
    const gridColor = grid ? styles.getPropertyValue("--at-border").trim() : undefined;
    const labelColor = grid ? styles.getPropertyValue("--at-text-secondary").trim() : undefined;
    drawWaveform(ctx, samples, {
      stroke: stroke || "#e2b13c",
      background: "transparent",
      gridColor,
      labelColor,
    });
  }
</script>

<style>
  .waveform {
    margin: 0;
  }

  canvas {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--at-border);
    border-radius: var(--at-border-radius);
    background: var(--at-bg-alt);
  }

  figcaption {
    margin-top: 0.35rem;
    font-size: var(--at-font-size-xs);
    color: var(--at-text-secondary);
  }

  /* TONE pages have no soft-panel chrome to round a display into — flatten
     the theme's default corner radius there without touching legacy pages. */
  :global([data-tone]) canvas {
    border-radius: 0;
  }

  :global([data-tone]) figcaption {
    font-family: var(--t-mono);
    font-size: var(--t-label);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
</style>
