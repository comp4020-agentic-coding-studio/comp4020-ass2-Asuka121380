---
// A standard play/stop control for a "Hear It" demo. It renders the button
// and status text; the page's own script starts/stops its Web Audio graph
// and calls `setAudioDemoState(id, playing)` to keep this control in sync.
interface Props {
  id: string;
  label: string;
}

const { id, label } = Astro.props;
---

<div class="audio-demo" data-audio-demo={id}>
  <button type="button" id={`${id}-toggle`} aria-pressed="false" class="footswitch-button">
    <span class="led" aria-hidden="true"></span>
    <span class="footswitch-label">
      <span class="play-icon" aria-hidden="true">▶</span>
      <span class="stop-icon" aria-hidden="true">■</span>
      {label}
    </span>
  </button>
  <p class="hint">Audio never plays automatically — press play to hear it, press again to stop.</p>
</div>

<script>
  declare global {
    interface Window {
      setAudioDemoState?: (id: string, playing: boolean) => void;
    }
  }

  window.setAudioDemoState = (id: string, playing: boolean) => {
    const button = document.getElementById(`${id}-toggle`);
    button?.setAttribute("aria-pressed", String(playing));
  };
</script>

<style>
  .audio-demo {
    margin-block: 1rem;
  }

  .footswitch-button {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.6rem 1.1rem;
    border: 1px solid var(--at-border);
    border-radius: calc(var(--at-border-radius) * 0.6);
    background: var(--at-bg);
    color: var(--at-heading);
    font: inherit;
    cursor: pointer;
  }

  .led {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: var(--at-border);
    flex: none;
  }

  .footswitch-label {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--bench-readout, var(--at-font-mono));
    font-size: var(--at-font-size-sm);
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .footswitch-button .stop-icon {
    display: none;
  }

  .footswitch-button[aria-pressed="true"] .play-icon {
    display: none;
  }

  .footswitch-button[aria-pressed="true"] .stop-icon {
    display: inline;
  }

  .footswitch-button[aria-pressed="true"] {
    border-color: var(--at-accent);
    background: var(--at-bg-alt);
  }

  .footswitch-button[aria-pressed="true"] .led {
    background: var(--at-accent);
    box-shadow: 0 0 6px var(--at-accent);
  }

  .hint {
    margin-top: 0.35rem;
    font-size: var(--at-font-size-xs);
    color: var(--at-text-secondary);
  }
</style>
