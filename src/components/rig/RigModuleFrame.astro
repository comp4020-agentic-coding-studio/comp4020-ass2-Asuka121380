---
// Week 3's own register: "the week is a module, the lab is the processor"
// (CLAUDE.md's signal-processing-environment revision). Deliberately NOT
// BenchFrame — that component is shared by all 12 weeks and stays
// untouched, so this is a new, parallel, Week-3-exclusive wrapper that
// never imports it. Reproduces the same utility class NAMES BenchFrame
// provides (bench-wide/bench-annotated/bench-eyebrow/bench-module/
// bench-callout/bench-scope-note/bench-prose) scoped under this frame's own
// ancestor class, so week-03.mdx's body needs no rewriting — only its
// imports change. Also defines --bench-phosphor/--bench-line/etc. locally
// (not at :root) so PickupBench/PickupDiagram/Knob/Waveform/Spectrum/
// AudioDemo/FootswitchGroup — all shared, unedited primitives that read
// these tokens — re-theme automatically inside this frame.
//
// Unlike Bench & Booth's light/dark "desk"/"bench" alternation, this stays
// one continuous dark processor environment throughout (CLAUDE.md: "dark
// areas allowed but must represent a software workspace... not because the
// last section was light") — module-header prominence marks a new stage,
// not a colour flip.
interface Props {
  week?: number;
  topic?: string;
}

const { week = 3, topic = "PICKUP" } = Astro.props;
const weekCode = `WK${String(week).padStart(2, "0")}`;
---

<div class="rig-module-frame">
  <div class="rig-module-strip" role="note" aria-label="Course and module identifier">
    <span class="rig-module-dot" aria-hidden="true"></span>
    <span>SLOP2186</span><span class="rig-module-sep" aria-hidden="true">·</span><span>{weekCode}</span><span class="rig-module-sep" aria-hidden="true">·</span><span>MODULE {String(week).padStart(2, "0")} / {topic}</span>
  </div>
  <slot />
</div>

<style is:global>
  .rig-module-frame {
    --bench-phosphor: #42d7c5;
    --bench-input-trace: color-mix(in srgb, #d08a2e 85%, transparent);
    --bench-line: color-mix(in srgb, #8c9298 26%, transparent);
    --bench-grid: color-mix(in srgb, #8c9298 13%, transparent);
    --bench-readout: var(--at-font-mono);
    --bench-panel-text-secondary: color-mix(in srgb, #e8e7e2 70%, transparent);

    --at-bg: #101112;
    --at-bg-alt: #1b1c1e;
    --at-bg-elevated: #202225;
    --at-border: var(--bench-line);
    --at-divider: var(--bench-line);
    --at-text: #e8e7e2;
    --at-text-secondary: color-mix(in srgb, #e8e7e2 70%, transparent);
    --at-text-muted: #8c9298;
    --at-heading: #e8e7e2;
    --at-accent: #42d7c5;

    background: var(--at-bg);
    color: var(--at-text);
    counter-reset: bench-section;
    display: flow-root;
  }

  .rig-module-strip {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--bench-readout);
    font-size: var(--at-font-size-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--at-text-secondary);
    border-bottom: 1px solid var(--bench-line);
    padding-block: 0.6rem;
    margin-block-end: 1.5rem;
  }

  .rig-module-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--bench-phosphor);
    box-shadow: 0 0 5px var(--bench-phosphor);
    flex: none;
  }

  .rig-module-sep {
    color: var(--at-text-muted);
  }

  .rig-module-frame .bench-wide {
    --rig-scrollbar-gutter: calc(100vw - 100%);
    width: calc(100vw - var(--rig-scrollbar-gutter));
    max-width: min(76rem, 100vw - var(--rig-scrollbar-gutter) - 2 * var(--at-gutter));
    margin-inline: calc(50% - 50vw + var(--rig-scrollbar-gutter) / 2);
    box-sizing: border-box;
  }

  .rig-module-frame .bench-annotated {
    display: grid;
    gap: 1.5rem;
    align-items: center;
  }

  @media (min-width: 860px) {
    .rig-module-frame .bench-annotated {
      grid-template-columns: 1.5fr 1fr;
    }
  }

  .rig-module-frame .bench-eyebrow {
    display: block;
    font-family: var(--bench-readout);
    font-size: var(--at-font-size-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--at-text-secondary);
    margin-bottom: 0.35rem;
  }

  .rig-module-frame .bench-module {
    border: 1px solid var(--at-border);
    border-radius: 0.2rem;
    background: var(--at-bg-alt);
    background-image:
      linear-gradient(var(--bench-grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--bench-grid) 1px, transparent 1px);
    background-size: 24px 24px;
    background-position: -1px -1px;
    padding: 1.25rem;
  }

  .rig-module-frame .bench-callout {
    border-left: 3px solid var(--bench-phosphor);
    background: var(--at-bg-alt);
    border-radius: 0 0.2rem 0.2rem 0;
    padding: 0.9rem 1.1rem;
    margin-block: 1.25rem;
  }

  .rig-module-frame .bench-callout p {
    margin: 0;
  }

  .rig-module-frame .bench-scope-note {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    font-size: var(--at-font-size-sm);
    color: var(--at-text-secondary);
    border: 1px dashed var(--at-border);
    border-radius: 0.2rem;
    padding: 0.5rem 0.75rem;
    margin-block: 1rem;
  }

  .rig-module-frame .bench-scope-note::before {
    content: "SCOPE";
    font-family: var(--bench-readout);
    font-size: var(--at-font-size-xs);
    letter-spacing: 0.08em;
    color: var(--bench-phosphor);
    flex: none;
  }

  .rig-module-frame .bench-prose {
    max-width: 38rem;
  }

  .rig-module-frame section {
    margin-block: 0;
  }

  .rig-module-frame h2 {
    counter-increment: bench-section;
    position: relative;
    margin-bottom: 0.75rem;
  }

  .rig-module-frame h2::before {
    content: counter(bench-section, decimal-leading-zero);
    position: absolute;
    right: 100%;
    top: 0.2em;
    padding-inline-end: 0.6rem;
    font-family: var(--bench-readout);
    font-size: var(--at-font-size-xs);
    font-weight: 400;
    letter-spacing: 0;
    color: var(--bench-phosphor);
    opacity: 0.7;
  }

  .rig-module-frame p {
    line-height: 1.7;
  }

  /* Compact the site-wide sticky Nav on this page only, same technique as
     RigFrame.astro uses for the Homepage — never edits the vendored
     Nav.astro/BaseLayout.astro. */
  body:has(.rig-module-frame) .at-nav {
    padding-block: 0.65rem;
  }

  body:has(.rig-module-frame) .at-nav picture,
  body:has(.rig-module-frame) .at-nav img {
    max-height: 1.75rem;
  }
</style>
