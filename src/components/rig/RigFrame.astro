---
// The Homepage's own register: "a guitar signal-processing environment that
// happens to teach a university course." Deliberately NOT EditorialFrame —
// that component is shared with assessments/people/policies/sessions pages
// that stay in the previous register for now, so this is a new, parallel,
// homepage-only wrapper that never imports it. Remaps --at-* to a dark
// graphite/cyan/amber palette; every descendant that already reads --at-*
// (Waveform, Spectrum, Knob, AudioDemo, FootswitchGroup, plus this file's
// own --rig-* tokens) re-themes with no edits to its own source.
//
// This page renders inside a `<main data-canvas>` (see BaseLayout's
// `mainAttrs` prop and src/styles/canvas-reset.css), which strips the
// vendor's body::after rail and 48rem content-grid entirely — so, unlike an
// earlier version of this component, .rig-frame is the SINGLE place that
// now owns this page's horizontal margins and max width. Nothing under it
// should reach for a per-section "wide" breakout hack; there is no grid
// left to escape.
//
// The .rig-frame marker class also drives a body:has() override (below)
// that compacts the vendored theme's Nav on this page only, without
// touching Nav.astro/BaseLayout.astro (both shared site-wide, off-limits).
---

<div class="rig-frame">
  <slot />
</div>

<style is:global>
  .rig-frame {
    /* Graphite/near-black voids and panels. */
    --rig-void: #101112;
    --rig-void-raised: #151617;
    --rig-panel: #1b1c1e;
    --rig-panel-raised: #202225;
    --rig-panel-high: #26282b;

    /* Text. */
    --rig-text: #e8e7e2;
    --rig-text-secondary: color-mix(in srgb, #e8e7e2 68%, transparent);
    --rig-text-muted: #8c9298;

    /* Signal colour semantics — never decoration. Cyan = active signal /
       measurement / current state. Amber = analogue / hardware / source.
       Warn = clipping / overload, used only where semantically meaningful. */
    --rig-signal: #42d7c5;
    --rig-signal-dim: color-mix(in srgb, #42d7c5 45%, transparent);
    --rig-analogue: #d08a2e;
    --rig-warn: #c9612f;

    --rig-line: color-mix(in srgb, #8c9298 28%, transparent);
    --rig-grid: color-mix(in srgb, #8c9298 14%, transparent);
    --rig-mono: var(--at-font-mono);

    background: var(--rig-void);
    color: var(--rig-text);

    /* Remap the theme's semantic tokens so every shared component (Waveform,
       Spectrum, Knob, AudioDemo, FootswitchGroup, Card/CardGrid) re-themes
       automatically inside this frame. */
    --at-bg: var(--rig-void);
    --at-bg-alt: var(--rig-panel);
    --at-bg-elevated: var(--rig-panel-raised);
    --at-border: var(--rig-line);
    --at-divider: var(--rig-line);
    --at-text: var(--rig-text);
    --at-text-secondary: var(--rig-text-secondary);
    --at-text-muted: var(--rig-text-muted);
    --at-heading: var(--rig-text);
    --at-accent: var(--rig-signal);

    display: flow-root;

    /* The page's own margin and max width — the only place either is set.
       Wide on large screens (this is a workspace, not a text column) but
       capped so a signal chain doesn't stretch to unreadable width on an
       ultrawide monitor. */
    padding-inline: clamp(1.25rem, 4vw, 3.5rem);
    max-width: 96rem;
    margin-inline: auto;
  }

  .rig-frame a {
    color: inherit;
  }

  .rig-frame .rig-eyebrow {
    display: block;
    font-family: var(--rig-mono);
    font-size: var(--at-font-size-xs);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--rig-text-muted);
  }

  .rig-frame section + section {
    margin-block-start: clamp(3rem, 7vw, 5.5rem);
    border-block-start: 1px solid var(--rig-line);
    padding-block-start: clamp(2rem, 5vw, 3.5rem);
  }

  .rig-frame > section:last-child {
    padding-block-end: clamp(3rem, 6vw, 5rem);
  }

  /* Compact the site-wide sticky Nav on this page only, via :has() rather
     than editing the vendored Nav.astro/BaseLayout.astro — the same
     technique the theme's own components.css already relies on
     (.at-nav-brand:has(...)), so it's an established, safe pattern here. */
  body:has(.rig-frame) .at-nav {
    padding-block: 0.65rem;
  }

  body:has(.rig-frame) .at-nav picture,
  body:has(.rig-frame) .at-nav img {
    max-height: 1.75rem;
  }
</style>
