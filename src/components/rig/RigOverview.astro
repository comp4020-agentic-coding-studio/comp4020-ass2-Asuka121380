---
// "THE COURSE IS THE RIG": the Homepage's strongest conceptual component,
// the whole 12-week course rendered as one virtual signal chain — an effect-
// slot rack, not a course-catalogue list, not twelve equal cards. Sourced
// live from the lectures collection (never hardcoded), reusing
// MODULE_META's real curriculum-domain tagging (physical vs. signal) that
// previously lived in SignalChainNav.astro (this file replaces it as its
// own homepage section, pulled out of RigHero so the Hero and the Overview
// each get room to be their own composition per Section 5/9 of the current
// brief). Homepage-exclusive.
//
// Each module's trace is computed once at build time from the SAME analysis
// primitives the labs themselves use (harmonicSeriesCycle, pickupHarmonic-
// Weights, buildClippingCurve, ...) rather than an arbitrary decorative
// squiggle — so a student who has already met a stage's real lab recognises
// its shape here. A few stages (MODULATION's slow tremolo, SPACE's decaying
// echo) have no dedicated lab primitive to reuse and are built from plain
// sine/decay maths instead; both are commented where that trade-off is made.
// None of this claims lab-grade accuracy — it is a homepage motif, not a
// measurement.
import { getPublishedCollection } from "astro-course-university/content";
import { withBase } from "astro-theme-university/url";
import {
  applyCurve,
  harmonicSeriesCycle,
  pickupHarmonicWeights,
  pluckHarmonicWeights,
  sineCycle,
} from "../../lib/audio/analysis";
import { buildClippingCurve } from "../../lib/audio/waveshaping";
import { waveformPath } from "../../lib/draw/svgTrace";

interface ModuleMeta {
  tag: string;
  domain: "physical" | "signal";
  blurb: string;
}

const MODULE_META: Record<number, ModuleMeta> = {
  1: { tag: "INPUT", domain: "physical", blurb: "A player's motion enters the system." },
  2: { tag: "STRING", domain: "physical", blurb: "String motion → a standing wave of harmonics." },
  3: { tag: "PICKUP", domain: "signal", blurb: "Motion → induced voltage. Position sets the blend." },
  4: { tag: "CIRCUIT", domain: "signal", blurb: "Passive tone/volume shape the signal before it leaves the guitar." },
  5: { tag: "DRIVE", domain: "signal", blurb: "Gain pushes the signal toward a nonlinear ceiling." },
  6: { tag: "DISTORTION", domain: "signal", blurb: "Harder clipping — a squared-off, harmonic-rich wave." },
  7: { tag: "FILTER", domain: "signal", blurb: "Frequency-selective shaping changes which harmonics dominate." },
  8: { tag: "MODULATION", domain: "signal", blurb: "A slow periodic control vibrates a parameter of the signal." },
  9: { tag: "SPACE", domain: "signal", blurb: "Delayed, decaying repeats build depth and distance." },
  10: { tag: "AMP", domain: "signal", blurb: "Preamp and power stages add gain and harmonic density." },
  11: { tag: "SPEAKER", domain: "physical", blurb: "Electrical signal → a filtered mechanical pressure wave." },
  12: { tag: "OUTPUT", domain: "physical", blurb: "The pressure wave reaches a listener's ear." },
};

const TRACE_SAMPLES = 96;

/** Cheap 3-point moving-average smoothing — stands in for a speaker cone's
 *  mechanical low-pass behaviour; not a measured driver response. */
function smooth(cycle: Float64Array): Float64Array {
  const out = new Float64Array(cycle.length);
  for (let i = 0; i < cycle.length; i++) {
    const prev = cycle[(i - 1 + cycle.length) % cycle.length];
    const next = cycle[(i + 1) % cycle.length];
    out[i] = (prev + cycle[i] + next) / 3;
  }
  return out;
}

function cycleFor(week: number): Float64Array {
  switch (week) {
    case 1:
      return sineCycle(TRACE_SAMPLES);
    case 2:
      return harmonicSeriesCycle(pluckHarmonicWeights(0.18), TRACE_SAMPLES);
    case 3:
      return harmonicSeriesCycle(pickupHarmonicWeights(0.28), TRACE_SAMPLES);
    case 4:
      return applyCurve(
        harmonicSeriesCycle(pickupHarmonicWeights(0.28), TRACE_SAMPLES),
        buildClippingCurve("symmetric-soft", 1.15),
      );
    case 5:
      return applyCurve(
        harmonicSeriesCycle(pickupHarmonicWeights(0.28), TRACE_SAMPLES),
        buildClippingCurve("symmetric-soft", 3),
      );
    case 6:
      return applyCurve(
        harmonicSeriesCycle(pickupHarmonicWeights(0.28), TRACE_SAMPLES),
        buildClippingCurve("hard", 4),
      );
    case 7:
      // Spectral emphasis shift: keep only the low-order harmonics that
      // survive a low-pass filter, dropping the rest to zero.
      return harmonicSeriesCycle(pickupHarmonicWeights(0.28).slice(0, 3), TRACE_SAMPLES);
    case 8: {
      // No dedicated lab primitive for a slow periodic control — a plain
      // amplitude-modulated sine, built here rather than reused.
      const carrier = sineCycle(TRACE_SAMPLES);
      return carrier.map((s, i) => s * (0.55 + 0.45 * Math.sin((i / TRACE_SAMPLES) * 2 * Math.PI * 3))) as Float64Array;
    }
    case 9: {
      // No dedicated lab primitive for delay/reverb here — a short decaying
      // echo built from three shifted, shrinking copies of one pluck cycle.
      const base = harmonicSeriesCycle(pluckHarmonicWeights(0.28), TRACE_SAMPLES);
      const out = new Float64Array(TRACE_SAMPLES);
      const shift = Math.round(TRACE_SAMPLES / 6);
      for (let i = 0; i < TRACE_SAMPLES; i++) {
        out[i] =
          base[i] * 0.9 +
          base[(i - shift + TRACE_SAMPLES) % TRACE_SAMPLES] * 0.55 +
          base[(i - shift * 2 + TRACE_SAMPLES) % TRACE_SAMPLES] * 0.3;
      }
      const peak = Math.max(...out.map(Math.abs), 1e-9);
      return out.map((s) => s / peak) as Float64Array;
    }
    case 10:
      return applyCurve(
        harmonicSeriesCycle(pickupHarmonicWeights(0.28).slice(0, 3), TRACE_SAMPLES),
        buildClippingCurve("fuzz", 2),
      );
    case 11:
      return smooth(cycleFor(10));
    case 12:
      return smooth(smooth(cycleFor(10)));
    default:
      return sineCycle(TRACE_SAMPLES);
  }
}

const lectures = (await getPublishedCollection("lectures")).sort((a, b) => a.data.week - b.data.week);

const modules = lectures.map((lecture) => {
  const meta = MODULE_META[lecture.data.week] ?? { tag: "STAGE", domain: "signal" as const, blurb: "" };
  const path = waveformPath(cycleFor(lecture.data.week), { width: 120, height: 30, padding: 2 });
  return {
    lecture,
    meta,
    path,
    weekIndex: String(lecture.data.week).padStart(2, "0"),
  };
});
---

<div class="rig-overview">
  <ol class="chain-rack-list">
    {
      modules.map(({ lecture, meta, path, weekIndex }) => (
        <li class:list={["chain-rack-node", `chain-rack-node--${meta.domain}`]}>
          <a
            class="chain-rack-link"
            href={withBase(`/lectures/${lecture.id}/`)}
            aria-label={`Module ${weekIndex}, ${meta.tag}: ${lecture.data.title}. ${meta.blurb}`}
          >
            <span class="chain-rack-top">
              <span class="chain-rack-index" aria-hidden="true">{weekIndex}</span>
              <span class="chain-rack-dot" aria-hidden="true" />
            </span>
            <svg
              class="chain-rack-trace"
              viewBox="0 0 120 30"
              preserveAspectRatio="none"
              aria-hidden="true"
            >
              <path d={path} fill="none" />
            </svg>
            <span class="chain-rack-tag" aria-hidden="true">{meta.tag}</span>
            <span class="chain-rack-desc" aria-hidden="true">{meta.blurb}</span>
          </a>
        </li>
      ))
    }
  </ol>
</div>

<style>
  .rig-overview {
    --chain-rack-min: 5.5rem;
  }

  .chain-rack-list {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .chain-rack-node {
    display: flex;
  }

  .chain-rack-link {
    position: relative;
    display: flex;
    flex-direction: column;
    width: 100%;
    gap: 0.35rem;
    padding-block: 0.4rem 0.6rem;
    border-block-start: 1px solid var(--rig-line);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s ease;
  }

  .chain-rack-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
  }

  .chain-rack-index {
    font-family: var(--rig-mono);
    font-size: 0.62rem;
    color: var(--rig-text-muted);
  }

  .chain-rack-dot {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--rig-void);
    border: 1.5px solid var(--rig-text-muted);
    transition:
      border-color 0.15s ease,
      box-shadow 0.15s ease;
  }

  .chain-rack-node--signal .chain-rack-dot {
    border-color: color-mix(in srgb, var(--rig-signal) 55%, var(--rig-text-muted));
  }

  .chain-rack-node--physical .chain-rack-dot {
    border-color: color-mix(in srgb, var(--rig-analogue) 55%, var(--rig-text-muted));
  }

  .chain-rack-trace {
    display: block;
    width: 100%;
    height: 1.9rem;
  }

  .chain-rack-trace path {
    stroke: var(--rig-text-muted);
    stroke-width: 1.3;
    transition: stroke 0.15s ease;
  }

  .chain-rack-node--signal .chain-rack-trace path {
    stroke: color-mix(in srgb, var(--rig-signal) 55%, var(--rig-text-muted));
  }

  .chain-rack-node--physical .chain-rack-trace path {
    stroke: color-mix(in srgb, var(--rig-analogue) 55%, var(--rig-text-muted));
  }

  .chain-rack-tag {
    font-family: var(--rig-mono);
    font-size: 0.72rem;
    letter-spacing: 0.07em;
    color: var(--rig-analogue);
  }

  .chain-rack-node--signal .chain-rack-tag {
    color: var(--rig-signal);
  }

  /* The compact explanation: present in the DOM, collapsed to nothing by
     default (not display:none, so it still transitions) — Section 10's
     "no giant hover cards, subtle state changes" rather than a tooltip
     library or a popover. */
  .chain-rack-desc {
    display: block;
    max-height: 0;
    overflow: hidden;
    font-size: 0.72rem;
    line-height: 1.4;
    color: var(--rig-text-secondary);
    opacity: 0;
    transition:
      max-height 0.18s ease,
      opacity 0.18s ease;
  }

  /* Active / current state on the hovered or focused module: brighten its
     own dot, trace, and reveal its description. */
  .chain-rack-link:hover,
  .chain-rack-link:focus-visible {
    border-block-start-color: var(--rig-signal);
  }

  .chain-rack-link:hover .chain-rack-dot,
  .chain-rack-link:focus-visible .chain-rack-dot {
    border-color: var(--rig-signal);
    background: var(--rig-signal);
    box-shadow: 0 0 6px var(--rig-signal-dim);
  }

  .chain-rack-link:hover .chain-rack-trace path,
  .chain-rack-link:focus-visible .chain-rack-trace path {
    stroke: var(--rig-signal);
    stroke-width: 1.6;
  }

  .chain-rack-link:hover .chain-rack-desc,
  .chain-rack-link:focus-visible .chain-rack-desc {
    max-height: 3.5rem;
    opacity: 1;
  }

  /* Upstream state: every module before the one under the pointer/focus
     gets a quiet "signal has already passed through here" tint on its
     top rule, via :has() rather than JS — Section 10's active/upstream/
     downstream vocabulary expressed as CSS, not a script. */
  .chain-rack-node:has(~ .chain-rack-node .chain-rack-link:hover) .chain-rack-link,
  .chain-rack-node:has(~ .chain-rack-node .chain-rack-link:focus-visible) .chain-rack-link {
    border-block-start-color: color-mix(in srgb, var(--rig-signal) 45%, var(--rig-line));
  }

  @media (min-width: 34rem) {
    .chain-rack-list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  /* Desktop: the chain becomes one continuous horizontal rack, a spatial
     signal path rather than a grouped grid (Section 12). */
  @media (min-width: 72rem) {
    .chain-rack-list {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: 0 0.5rem;
    }

    .chain-rack-link {
      padding-inline: 0.35rem;
    }

    .chain-rack-desc {
      position: absolute;
      inset-inline: 0;
      top: 100%;
      z-index: 2;
      max-width: 12rem;
      padding-top: 0.3rem;
      background: var(--rig-void);
    }
  }
</style>
