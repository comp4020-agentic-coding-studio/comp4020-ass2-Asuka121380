---
// Week 3's opening composition: "MODULE 03 / PICKUP / From Vibration to
// Voltage", a macro photograph with technical annotations, and an
// INPUT/PROCESS/OUTPUT row — one composition, not a generic university
// header followed by a separate dark card. Deliberately NOT Week3Opener
// (EditorialFrame-based); this is a new, parallel, Week-3-exclusive
// component meant to render as the first child inside RigModuleFrame, so it
// inherits that frame's dark palette rather than defining its own.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  week: number;
  topic: string;
  title: string;
  input: string;
  process: string;
  output: string;
  image: ImageMetadata;
}

const { week, topic, title, input, process, output, image } = Astro.props;
const index = String(week).padStart(2, "0");
---

<header class="rig-opener">
  <div class="rig-opener-copy">
    <p class="rig-eyebrow">SLOP2186 &middot; MODULE {index}</p>
    <div class="rig-opener-heading">
      <span class="rig-opener-index" aria-hidden="true">{index}</span>
      <div>
        <p class="rig-opener-topic">{topic}</p>
        <h1 class="rig-opener-title">{title}</h1>
      </div>
    </div>
    <div class="rig-opener-body">
      <slot />
    </div>
  </div>

  <figure class="rig-opener-figure">
    <div class="rig-opener-image-wrap">
      <Image
        src={image}
        alt="Close-up photograph of humbucker and single-coil guitar pickups mounted on a pickguard."
        widths={[420, 760]}
        sizes="(max-width: 56rem) 85vw, 32rem"
        format="avif"
        loading="eager"
        class="rig-opener-image"
      />
      <ul class="rig-opener-annotations" aria-hidden="true">
        <li style="--x: 12%; --y: 14%;">STRING</li>
        <li style="--x: 66%; --y: 8%;">MAGNETIC FIELD</li>
        <li style="--x: 74%; --y: 62%;">POLE PIECE</li>
        <li style="--x: 18%; --y: 80%;">COIL</li>
      </ul>
    </div>
    <figcaption>Photo: Feitscherg &middot; Public domain</figcaption>
  </figure>

  <div class="rig-opener-row" role="img" aria-label={`Input: ${input}. Process: ${process}. Output: ${output}.`}>
    <div class="rig-opener-cell">
      <span class="rig-opener-cell-label">INPUT</span>
      <span class="rig-opener-cell-value">{input}</span>
    </div>
    <span class="rig-opener-cell-arrow" aria-hidden="true">&rarr;</span>
    <div class="rig-opener-cell">
      <span class="rig-opener-cell-label">PROCESS</span>
      <span class="rig-opener-cell-value">{process}</span>
    </div>
    <span class="rig-opener-cell-arrow" aria-hidden="true">&rarr;</span>
    <div class="rig-opener-cell rig-opener-cell--out">
      <span class="rig-opener-cell-label">OUTPUT</span>
      <span class="rig-opener-cell-value">{output}</span>
    </div>
  </div>
</header>

<style>
  .rig-opener {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1.5rem, 4vw, 2.5rem);
    padding-block-end: 2rem;
  }

  .rig-opener-copy {
    max-width: 36rem;
  }

  .rig-opener-heading {
    display: flex;
    align-items: baseline;
    gap: 1.25rem;
    margin-block: 0.75rem 1.25rem;
  }

  .rig-opener-index {
    font-family: var(--bench-readout, var(--at-font-mono));
    font-weight: 700;
    font-size: clamp(2.4rem, 6vw, 3.6rem);
    line-height: 1;
    color: var(--bench-phosphor, var(--at-accent));
    opacity: 0.9;
  }

  .rig-opener-topic {
    margin: 0 0 0.15rem;
    font-family: var(--bench-readout, var(--at-font-mono));
    font-size: var(--at-font-size-xs);
    letter-spacing: 0.12em;
    color: var(--at-text-secondary);
  }

  .rig-opener-title {
    margin: 0;
    font-size: clamp(1.9rem, 4.2vw, 2.9rem);
    line-height: 1.08;
    letter-spacing: -0.01em;
  }

  .rig-opener-body :global(h2) {
    font-size: clamp(1.3rem, 2.2vw, 1.7rem);
    line-height: 1.25;
    max-width: 34rem;
  }

  .rig-opener-body :global(.lecture-connection) {
    max-width: 34rem;
    color: var(--at-text-secondary);
    font-size: var(--at-font-size-sm);
  }

  .rig-opener-figure {
    margin: 0;
    width: min(100%, 28rem);
  }

  .rig-opener-image-wrap {
    position: relative;
  }

  .rig-opener-image {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    filter: saturate(0.75) contrast(1.05);
    border: 1px solid var(--at-border);
  }

  .rig-opener-annotations {
    position: absolute;
    inset: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .rig-opener-annotations li {
    position: absolute;
    left: var(--x);
    top: var(--y);
    font-family: var(--bench-readout, var(--at-font-mono));
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    color: var(--bench-phosphor, var(--at-accent));
    background: color-mix(in oklch, var(--at-bg) 78%, transparent);
    padding: 0.15rem 0.4rem;
    white-space: nowrap;
  }

  .rig-opener-figure figcaption {
    margin-top: 0.5rem;
    font-family: var(--bench-readout, var(--at-font-mono));
    font-size: 0.65rem;
    letter-spacing: 0.04em;
    color: var(--at-text-secondary);
    opacity: 0.8;
  }

  .rig-opener-row {
    display: flex;
    align-items: stretch;
    flex-wrap: wrap;
    gap: 0.75rem;
    border-top: 1px solid var(--bench-line, var(--at-border));
    padding-block-start: 1.5rem;
  }

  .rig-opener-cell {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 8rem;
  }

  .rig-opener-cell-label {
    font-family: var(--bench-readout, var(--at-font-mono));
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    color: var(--at-text-secondary);
  }

  .rig-opener-cell--out .rig-opener-cell-label {
    color: var(--bench-phosphor, var(--at-accent));
  }

  .rig-opener-cell-value {
    font-size: 0.95rem;
  }

  .rig-opener-cell-arrow {
    align-self: center;
    color: var(--at-text-muted);
    padding-inline: 0.25rem;
  }

  @media (min-width: 56rem) {
    .rig-opener {
      grid-template-columns: 1.2fr 0.8fr;
      grid-template-areas:
        "copy figure"
        "row row";
    }

    .rig-opener-copy {
      grid-area: copy;
    }

    .rig-opener-figure {
      grid-area: figure;
      width: 100%;
      justify-self: end;
    }

    .rig-opener-row {
      grid-area: row;
    }
  }
</style>
