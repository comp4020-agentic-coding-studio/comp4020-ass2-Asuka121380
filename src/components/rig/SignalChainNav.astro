---
// The course itself IS the signal chain — the page's structural backbone,
// not a card grid or a separate "here's our curriculum" section. One
// horizontal rack of 12 modules threaded on a single line (a pedalboard
// signal path / DAW insert-chain, not a course-catalogue list), sourced
// live from the lectures collection (titles, ids, descriptions) so it can't
// drift from src/content/lectures. The tag on each module (INPUT, STRING,
// PICKUP, ... OUTPUT) is the curriculum's real per-week domain, not
// decoration — the chain's own endpoints already read INPUT -> OUTPUT, so
// nothing else needs to say so. Homepage-exclusive.
import { getPublishedCollection } from "astro-course-university/content";
import { withBase } from "astro-theme-university/url";

interface ModuleMeta {
  tag: string;
  domain: "physical" | "signal";
}

const MODULE_META: Record<number, ModuleMeta> = {
  1: { tag: "INPUT", domain: "physical" },
  2: { tag: "STRING", domain: "physical" },
  3: { tag: "PICKUP", domain: "signal" },
  4: { tag: "CIRCUIT", domain: "signal" },
  5: { tag: "DRIVE", domain: "signal" },
  6: { tag: "DISTORTION", domain: "signal" },
  7: { tag: "FILTER", domain: "signal" },
  8: { tag: "MODULATION", domain: "signal" },
  9: { tag: "SPACE", domain: "signal" },
  10: { tag: "AMP", domain: "signal" },
  11: { tag: "SPEAKER", domain: "physical" },
  12: { tag: "OUTPUT", domain: "physical" },
};

const lectures = (await getPublishedCollection("lectures")).sort((a, b) => a.data.week - b.data.week);
---

<nav class="chain-rack" aria-label="Course signal chain, week by week">
  <ol class="chain-rack-list">
    {
      lectures.map((lecture) => {
        const meta = MODULE_META[lecture.data.week] ?? { tag: "STAGE", domain: "signal" };
        const weekIndex = String(lecture.data.week).padStart(2, "0");
        return (
          <li class:list={["chain-rack-node", `chain-rack-node--${meta.domain}`]}>
            <a
              class="chain-rack-link"
              href={withBase(`/lectures/${lecture.id}/`)}
              aria-label={`Week ${lecture.data.week}: ${lecture.data.title}`}
            >
              <span class="chain-rack-dot" aria-hidden="true" />
              <span class="chain-rack-tag" aria-hidden="true">
                {meta.tag}
              </span>
              <span class="chain-rack-index" aria-hidden="true">
                {weekIndex}
              </span>
            </a>
          </li>
        );
      })
    }
  </ol>
</nav>

<style>
  .chain-rack {
    --chain-rack-min: 3.75rem;
  }

  .chain-rack-list {
    position: relative;
    display: flex;
    margin: 0;
    padding: 0.9rem 0 0.4rem;
    list-style: none;
    overflow-x: auto;
    scrollbar-width: thin;
  }

  .chain-rack-list::before {
    content: "";
    position: absolute;
    inset-inline: 0;
    top: 1.15rem;
    height: 1px;
    background: linear-gradient(to right, var(--rig-analogue), var(--rig-signal));
    opacity: 0.55;
  }

  .chain-rack-node {
    flex: 1 0 var(--chain-rack-min);
    display: flex;
    justify-content: center;
  }

  .chain-rack-link {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
    padding: 0.25rem 0.5rem 0.4rem;
    text-decoration: none;
    color: inherit;
  }

  .chain-rack-dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--rig-void);
    border: 1.5px solid var(--rig-text-muted);
    transition:
      border-color 0.15s ease,
      box-shadow 0.15s ease;
  }

  .chain-rack-node--signal .chain-rack-dot {
    border-color: color-mix(in srgb, var(--rig-signal) 55%, var(--rig-text-muted));
  }

  .chain-rack-link:hover .chain-rack-dot,
  .chain-rack-link:focus-visible .chain-rack-dot {
    border-color: var(--rig-signal);
    box-shadow: 0 0 6px var(--rig-signal-dim);
  }

  .chain-rack-tag {
    font-family: var(--rig-mono);
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    white-space: nowrap;
    color: var(--rig-analogue);
  }

  .chain-rack-node--signal .chain-rack-tag {
    color: var(--rig-signal);
  }

  .chain-rack-link:hover .chain-rack-tag,
  .chain-rack-link:focus-visible .chain-rack-tag {
    text-decoration: underline;
    text-decoration-color: currentColor;
  }

  .chain-rack-index {
    font-family: var(--rig-mono);
    font-size: 0.62rem;
    color: var(--rig-text-muted);
  }
</style>
