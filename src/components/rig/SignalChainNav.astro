---
// The course itself IS the signal chain: replaces the old card-based course
// journey with a software-inspired module chain / insert rack — one compact
// row per week, sourced live from the lectures collection (titles, ids,
// descriptions) so it can't drift from src/content/lectures, paired with a
// fixed per-week module tag + physical/signal domain (the curriculum's
// structure, not something this component invents). Homepage-exclusive.
import { getPublishedCollection } from "astro-course-university/content";
import { withBase } from "astro-theme-university/url";

interface ModuleMeta {
  tag: string;
  domain: "physical" | "signal";
}

const MODULE_META: Record<number, ModuleMeta> = {
  1: { tag: "INPUT", domain: "physical" },
  2: { tag: "STRING", domain: "physical" },
  3: { tag: "PICKUP", domain: "signal" },
  4: { tag: "CIRCUIT", domain: "signal" },
  5: { tag: "DRIVE", domain: "signal" },
  6: { tag: "DISTORTION", domain: "signal" },
  7: { tag: "FILTER", domain: "signal" },
  8: { tag: "MODULATION", domain: "signal" },
  9: { tag: "SPACE", domain: "signal" },
  10: { tag: "AMP", domain: "signal" },
  11: { tag: "SPEAKER", domain: "physical" },
  12: { tag: "OUTPUT", domain: "physical" },
};

const lectures = (await getPublishedCollection("lectures")).sort((a, b) => a.data.week - b.data.week);
---

<div class="chain-nav" id="signal-chain">
  <div class="chain-nav-rule" aria-hidden="true">
    <span>INPUT</span>
    <span class="chain-nav-rule-line"></span>
    <span>OUTPUT</span>
  </div>

  <ol class="chain-nav-rack">
    {
      lectures.map((lecture) => {
        const meta = MODULE_META[lecture.data.week] ?? { tag: "STAGE", domain: "signal" };
        return (
          <li class:list={["chain-nav-row", `chain-nav-row--${meta.domain}`]}>
            <a class="chain-nav-link" href={withBase(`/lectures/${lecture.id}/`)}>
              <span class="chain-nav-index">{String(lecture.data.week).padStart(2, "0")}</span>
              <span class="chain-nav-tag">{meta.tag}</span>
              <span class="chain-nav-title">{lecture.data.title}</span>
              <span class="chain-nav-week">WK{String(lecture.data.week).padStart(2, "0")}</span>
            </a>
          </li>
        );
      })
    }
  </ol>
</div>

<style>
  .chain-nav-rule {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    max-width: 20rem;
    margin-block-end: 1.5rem;
    font-family: var(--rig-mono);
    font-size: var(--at-font-size-xs);
    letter-spacing: 0.1em;
    color: var(--rig-text-muted);
  }

  .chain-nav-rule-line {
    flex: 1;
    height: 1px;
    background: var(--rig-line);
  }

  .chain-nav-rack {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--rig-line);
  }

  .chain-nav-row {
    border-bottom: 1px solid var(--rig-line);
  }

  .chain-nav-link {
    display: grid;
    grid-template-columns: 2.4rem 6.5rem 1fr 3.2rem;
    align-items: baseline;
    gap: 1rem;
    padding-block: 0.85rem;
    text-decoration: none;
    color: inherit;
    transition: background 0.12s ease;
  }

  .chain-nav-link:hover,
  .chain-nav-link:focus-visible {
    background: color-mix(in srgb, var(--rig-panel) 60%, transparent);
  }

  .chain-nav-index {
    font-family: var(--rig-mono);
    font-size: 0.85rem;
    color: var(--rig-text-muted);
  }

  .chain-nav-tag {
    font-family: var(--rig-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: var(--rig-analogue);
  }

  .chain-nav-row--signal .chain-nav-tag {
    color: var(--rig-signal);
  }

  .chain-nav-title {
    font-weight: 600;
    font-size: 1rem;
  }

  .chain-nav-link:hover .chain-nav-title,
  .chain-nav-link:focus-visible .chain-nav-title {
    text-decoration: underline;
    text-decoration-color: var(--rig-signal);
  }

  .chain-nav-week {
    justify-self: end;
    font-family: var(--rig-mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    color: var(--rig-text-muted);
  }

  @media (max-width: 40rem) {
    .chain-nav-link {
      grid-template-columns: auto 1fr;
      grid-template-areas:
        "index tag"
        "title title"
        "week week";
      row-gap: 0.2rem;
    }

    .chain-nav-index {
      grid-area: index;
    }

    .chain-nav-tag {
      grid-area: tag;
      justify-self: end;
    }

    .chain-nav-title {
      grid-area: title;
    }

    .chain-nav-week {
      grid-area: week;
      justify-self: start;
    }
  }
</style>
