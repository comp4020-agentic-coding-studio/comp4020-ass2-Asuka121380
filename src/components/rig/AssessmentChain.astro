---
// Homepage-only rendering of the fixed Analyse -> Manipulate -> Design
// assessment progression, as a vertical processing chain (STAGE 01 / 25% /
// ANALYSE) rather than three cards — sourced live from the assessments
// collection so weight/title/link can't drift. Deliberately NOT
// AssessmentProgression.astro, which assessments/index.mdx still uses and
// must stay untouched; this is a new, parallel component.
import { getPublishedCollection } from "astro-course-university/content";
import { withBase } from "astro-theme-university/url";

const VERBS = ["ANALYSE", "MANIPULATE", "DESIGN"] as const;

const assessments = (await getPublishedCollection("assessments")).sort((a, b) => a.data.week - b.data.week);
---

<ol class="assessment-chain">
  {
    assessments.map((assessment, i) => (
      <li class="assessment-chain-stage">
        <a class="assessment-chain-link" href={withBase(`/assessments/${assessment.id}/`)}>
          <span class="assessment-chain-index">STAGE {String(i + 1).padStart(2, "0")}</span>
          <span class="assessment-chain-weight">{assessment.data.weight}%</span>
          <span class="assessment-chain-verb">{VERBS[i] ?? ""}</span>
          <span class="assessment-chain-title">{assessment.data.title}</span>
        </a>
        {i < assessments.length - 1 && (
          <span class="assessment-chain-down" aria-hidden="true">
            &darr;
          </span>
        )}
      </li>
    ))
  }
</ol>

<style>
  .assessment-chain {
    margin: 0;
    padding: 0;
    list-style: none;
    max-width: 30rem;
  }

  .assessment-chain-stage {
    display: flex;
    flex-direction: column;
  }

  .assessment-chain-link {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 1.5rem;
    row-gap: 0.15rem;
    align-items: baseline;
    padding-block: 1.1rem;
    text-decoration: none;
    color: inherit;
  }

  .assessment-chain-index {
    grid-column: 1;
    grid-row: 1;
    font-family: var(--rig-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    color: var(--rig-text-muted);
  }

  .assessment-chain-weight {
    grid-column: 2;
    grid-row: 1 / span 2;
    justify-self: end;
    font-family: var(--rig-mono);
    font-weight: 700;
    font-size: clamp(2rem, 5vw, 3rem);
    color: var(--rig-signal);
    line-height: 1;
  }

  .assessment-chain-verb {
    grid-column: 1;
    grid-row: 2;
    font-family: var(--rig-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    color: var(--rig-analogue);
  }

  .assessment-chain-title {
    grid-column: 1;
    grid-row: 3;
    font-weight: 600;
    font-size: 1.05rem;
    margin-block-start: 0.3rem;
    border-bottom: 1px solid transparent;
  }

  .assessment-chain-link:hover .assessment-chain-title,
  .assessment-chain-link:focus-visible .assessment-chain-title {
    border-color: var(--rig-signal);
  }

  .assessment-chain-down {
    padding-inline-start: 0.15rem;
    color: var(--rig-line);
  }
</style>
