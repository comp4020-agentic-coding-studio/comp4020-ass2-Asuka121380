---
// The Homepage's first view: "the course is the rig." Not a cinematic
// lifestyle photo, not a giant black rectangle, not a card — a masthead
// (course code / title / one-sentence framing) that leads straight into the
// real 12-week signal chain (SignalChainNav) as the page's own structural
// backbone, with the real guitar-strings photograph docked at the chain's
// own INPUT end as the literal source feeding it, and one real waveform
// trace (the same plucked-string model used in ToneAnalysis) reading as
// that source's signal. No separate decorative "start" button — the chain
// itself is the navigation. Homepage-exclusive.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { harmonicSeriesCycle, pluckHarmonicWeights } from "../../lib/audio/analysis";
import { waveformPath } from "../../lib/draw/svgTrace";
import SignalChainNav from "./SignalChainNav.astro";

interface Props {
  eyebrow: string;
  title: string;
  lede: string;
  image: ImageMetadata;
}

const { eyebrow, title, lede, image } = Astro.props;

const cycle = harmonicSeriesCycle(pluckHarmonicWeights(0.18, 8), 160);
const path = waveformPath(cycle, { width: 200, height: 48, padding: 3 });
---

<header class="rig-hero">
  <div class="rig-hero-head">
    <p class="rig-eyebrow">{eyebrow}</p>
    <h1 class="rig-hero-title">{title}</h1>
    <p class="rig-hero-lede">{lede}</p>
  </div>

  <div class="rig-hero-chain">
    <figure class="rig-hero-source">
      <Image
        src={image}
        alt="Close-up photograph of electric guitar strings over the pickups."
        widths={[200, 320]}
        sizes="7rem"
        format="avif"
        loading="eager"
        class="rig-hero-source-image"
      />
      <figcaption class="rig-hero-source-caption">
        <span class="rig-hero-source-tag">SOURCE</span>
        <svg
          class="rig-hero-source-trace"
          viewBox="0 0 200 48"
          preserveAspectRatio="none"
          role="img"
          aria-label="Waveform of the input signal entering the chain."
        >
          <path d={path} fill="none" />
        </svg>
      </figcaption>
    </figure>

    <div class="rig-hero-rack">
      <SignalChainNav />
    </div>
  </div>
</header>

<style>
  .rig-hero {
    padding-block: clamp(1.5rem, 4vw, 2.5rem) clamp(2rem, 5vw, 3rem);
  }

  .rig-hero-head {
    max-width: 42rem;
  }

  .rig-hero-title {
    margin-block: 0.6rem 0.9rem;
    font-size: clamp(2.4rem, 6vw, 4rem);
    line-height: 1.02;
    letter-spacing: -0.015em;
    font-weight: 700;
  }

  .rig-hero-lede {
    max-width: 36rem;
    color: var(--rig-text-secondary);
    font-size: 1.05rem;
    line-height: 1.55;
  }

  .rig-hero-chain {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-block-start: clamp(2.5rem, 6vw, 4rem);
  }

  .rig-hero-source {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin: 0;
    flex: none;
  }

  .rig-hero-source-image {
    display: block;
    width: 4.5rem;
    height: 4.5rem;
    object-fit: cover;
    border-radius: 0.2rem;
    filter: saturate(0.72) contrast(1.05);
    border: 1px solid var(--rig-line);
    flex: none;
  }

  .rig-hero-source-caption {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .rig-hero-source-tag {
    font-family: var(--rig-mono);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    color: var(--rig-analogue);
  }

  .rig-hero-source-trace {
    display: block;
    width: 6rem;
    height: 1.5rem;
  }

  .rig-hero-source-trace path {
    stroke: var(--rig-signal);
    stroke-width: 1.4;
  }

  .rig-hero-rack {
    min-width: 0;
  }

  @media (min-width: 56rem) {
    .rig-hero-chain {
      flex-direction: row;
      align-items: center;
    }
  }
</style>
