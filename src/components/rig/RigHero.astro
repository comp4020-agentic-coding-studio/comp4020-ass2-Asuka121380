---
// The Homepage's first viewport: "the course is the rig," established
// immediately as ELECTRIC GUITAR + SIGNAL PROCESSING before a visitor reads
// a word — a strong left/right relationship (masthead vs. a large macro
// guitar photograph, aggressively cropped and unframed, not a card), not
// another dark hero rectangle. A physical->electrical signal strip along
// the bottom carries the eye from the guitar into the Rig Overview section
// immediately below (this component no longer owns the 12-week chain
// itself — see RigOverview.astro, pulled out so the Hero and the Overview
// can each be their own composition). Homepage-exclusive.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { harmonicSeriesCycle, pickupHarmonicWeights, pluckHarmonicWeights } from "../../lib/audio/analysis";
import { waveformPath } from "../../lib/draw/svgTrace";

interface Props {
  eyebrow: string;
  title: string;
  lede: string;
  image: ImageMetadata;
}

const { eyebrow, title, lede, image } = Astro.props;

// Left half of the strip: the string's own smooth vibration (physical,
// amber). Right half: the same vibration as sensed by a pickup (electrical,
// cyan) — the same PHYSICAL -> ELECTRICAL transition Week 3 goes on to
// teach in full, previewed here as a motif rather than explained.
const physicalCycle = harmonicSeriesCycle(pluckHarmonicWeights(0.18), 64);
const electricalCycle = harmonicSeriesCycle(pickupHarmonicWeights(0.28), 64);
const physicalPath = waveformPath(physicalCycle, { width: 200, height: 40, padding: 3 });
const electricalPath = waveformPath(electricalCycle, { width: 200, height: 40, padding: 3 });
---

<header class="rig-hero">
  <div class="rig-hero-grid">
    <div class="rig-hero-head">
      <p class="rig-eyebrow">{eyebrow}</p>
      <h1 class="rig-hero-title">{title}</h1>
      <p class="rig-hero-kicker">12 weeks. One signal chain.</p>
      <p class="rig-hero-lede">{lede}</p>
    </div>

    <figure class="rig-hero-image">
      <Image
        src={image}
        alt="Macro photograph of electric guitar strings crossing over a pickup, pole pieces and bridge hardware visible."
        widths={[480, 768, 1024]}
        sizes="(min-width: 56rem) 44vw, 100vw"
        format="avif"
        loading="eager"
        class="rig-hero-image-el"
      />
      <span class="rig-hero-image-fade" aria-hidden="true"></span>
    </figure>
  </div>

  <div
    class="rig-hero-signal"
    role="img"
    aria-label="Signal path: the string's physical vibration, entering at the left as input, becomes an electrical waveform after the pickup, continuing as output into the rig below."
  >
    <span class="rig-hero-signal-label rig-hero-signal-label--in">
      <span class="rig-hero-signal-dot rig-hero-signal-dot--in" aria-hidden="true"></span>INPUT
    </span>
    <svg class="rig-hero-signal-trace" viewBox="0 0 400 40" preserveAspectRatio="none" aria-hidden="true">
      <path d={physicalPath} class="rig-hero-signal-trace-physical" fill="none" />
      <g transform="translate(200,0)">
        <path d={electricalPath} class="rig-hero-signal-trace-electrical" fill="none" />
      </g>
    </svg>
    <span class="rig-hero-signal-label rig-hero-signal-label--out">
      OUTPUT<span class="rig-hero-signal-dot rig-hero-signal-dot--out" aria-hidden="true"></span>
    </span>
  </div>
</header>

<style>
  .rig-hero {
    padding-block: clamp(1.5rem, 4vw, 2.5rem) clamp(2rem, 5vw, 3rem);
  }

  .rig-hero-grid {
    display: grid;
    gap: clamp(2rem, 5vw, 3rem);
    align-items: center;
  }

  .rig-hero-head {
    max-width: 34rem;
  }

  .rig-hero-title {
    margin-block: 0.6rem 0.5rem;
    font-size: clamp(2.4rem, 6vw, 4rem);
    line-height: 1.02;
    letter-spacing: -0.015em;
    font-weight: 700;
  }

  .rig-hero-kicker {
    margin-block: 0 1.1rem;
    font-family: var(--rig-mono);
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--rig-signal);
  }

  .rig-hero-lede {
    max-width: 34rem;
    color: var(--rig-text-secondary);
    font-size: 1.05rem;
    line-height: 1.55;
  }

  .rig-hero-image {
    position: relative;
    margin: 0;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 0.2rem;
  }

  .rig-hero-image-el {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 42%;
    filter: saturate(0.82) contrast(1.08);
  }

  .rig-hero-image-fade {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, var(--rig-void) 0%, transparent 32%);
  }

  .rig-hero-signal {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-block-start: clamp(2.5rem, 6vw, 4rem);
  }

  .rig-hero-signal-label {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    flex: none;
    font-family: var(--rig-mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
  }

  .rig-hero-signal-label--in {
    color: var(--rig-analogue);
  }

  .rig-hero-signal-label--out {
    color: var(--rig-signal);
  }

  .rig-hero-signal-dot {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
  }

  .rig-hero-signal-dot--in {
    background: var(--rig-analogue);
  }

  .rig-hero-signal-dot--out {
    background: var(--rig-signal);
    box-shadow: 0 0 5px var(--rig-signal-dim);
  }

  .rig-hero-signal-trace {
    flex: 1;
    min-width: 0;
    height: 1.75rem;
  }

  .rig-hero-signal-trace-physical {
    stroke: var(--rig-analogue);
    stroke-width: 1.4;
  }

  .rig-hero-signal-trace-electrical {
    stroke: var(--rig-signal);
    stroke-width: 1.4;
  }

  @media (min-width: 56rem) {
    .rig-hero-grid {
      grid-template-columns: 1.05fr 1fr;
    }

    .rig-hero-image {
      aspect-ratio: 3 / 4;
    }
  }
</style>
