---
// The close: where to go next. Two weights — one large primary route into the
// teaching, and a quiet row of the practical pages — so the page ends on a
// decision rather than trailing off into a list of equal links.
import { Image } from "astro:assets";
import { withBase } from "astro-theme-university/url";
import { siteConfig } from "../../site-config";
import { courseMeta } from "../../course-config";
import pickupPhoto from "../../assets/images/week3-hero-humbucker-sg.jpg";

const practical = [
  {
    href: withBase("/assessments/"),
    label: "Assessment",
    detail: "What's graded, what it's worth, and when it's due.",
  },
  {
    href: withBase("/people/"),
    label: "People",
    detail: "Who teaches the course, and how to reach them.",
  },
  {
    href: withBase("/policies/"),
    label: "Policies",
    detail: "Late work, extensions, academic integrity, and getting help.",
  },
];
---

<section class="routes" aria-labelledby="routes-heading">
  <h2 class="visually-hidden" id="routes-heading">Where to go next</h2>

  <div class="t-shell">
    <div class="routes-primary">
      <figure class="routes-figure">
        <Image
          src={pickupPhoto}
          alt="Two nickel-covered humbucking pickups mounted on the deep red mahogany body of an electric guitar, with the strings running across their pole pieces toward the bridge."
          widths={[640, 960, 1400]}
          sizes="(min-width: 60rem) 52vw, 100vw"
          format="avif"
          class="routes-image"
        />
        <figcaption class="t-label routes-credit">
          Photo: John Tuggle <span aria-hidden="true">·</span> CC BY 2.0
        </figcaption>
      </figure>

      <div class="routes-copy">
        <p class="t-label t-label--signal">Start here</p>
        <p class="t-h2 routes-title">
          Week 01 — where a tone begins, and what is already fixed before a
          string is touched.
        </p>
        <p class="t-body routes-body">
          The twelve weeks run in order, and each one takes the previous week's
          output as its input. If you only read one to see how the course
          argues, read <a class="routes-inline" href={withBase("/lectures/week-03/")}>Week 03</a>,
          where string motion becomes voltage.
        </p>
        <div class="routes-actions">
          <a class="t-link" href={withBase("/lectures/week-01/")}>
            Begin week 01 <span class="t-arrow" aria-hidden="true">&rarr;</span>
          </a>
          <a class="t-link routes-link-quiet" href={withBase("/lectures/")}>
            All twelve weeks <span class="t-arrow" aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>
    </div>

    <ul class="routes-practical" role="list">
      {
        practical.map((route) => (
          <li>
            <a class="routes-practical-link" href={route.href}>
              <span class="routes-practical-label">{route.label}</span>
              <span class="routes-practical-detail">{route.detail}</span>
              <span class="routes-practical-arrow t-arrow" aria-hidden="true">
                &rarr;
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    <p class="routes-colophon t-label">
      {`${courseMeta.code} · ${siteConfig.name} · ${courseMeta.session} ${courseMeta.year}`}
    </p>
  </div>
</section>

<style>
  .routes {
    padding-block: var(--t-band) clamp(3rem, 6vw, 5rem);
  }

  .routes-primary {
    display: grid;
    gap: clamp(2rem, 4vw, 4rem);
    align-items: center;
  }

  .routes-figure {
    margin: 0;
    position: relative;
  }

  .routes-image {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    filter: saturate(0.88) contrast(1.06);
  }

  /* The attribution has to stay legible wherever it lands, and the bottom of
     this photograph is lit strings, not shadow. A short scrim guarantees the
     ground rather than relying on a text-shadow to survive a bright pixel. */
  .routes-figure::after {
    content: "";
    position: absolute;
    inset: auto 0 0;
    height: 4.5rem;
    background: linear-gradient(to top, rgb(10 11 12 / 88%), transparent);
    pointer-events: none;
  }

  .routes-credit {
    position: absolute;
    inset-block-end: 0.6rem;
    inset-inline-start: 0.75rem;
    font-size: 0.5625rem;
    color: rgb(241 239 234 / 78%);
    text-shadow: 0 1px 4px rgb(0 0 0 / 80%);
  }

  .routes-copy > .t-label {
    margin-block-end: 1.25rem;
  }

  .routes-title {
    margin: 0 0 1.25rem;
    max-width: 22ch;
  }

  .routes-body {
    margin: 0 0 1.75rem;
    max-width: 44ch;
  }

  .routes-inline {
    color: var(--t-signal);
    text-decoration-color: var(--t-signal-dim);
  }

  .routes-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1.75rem;
  }

  .routes-link-quiet {
    color: var(--t-dim);
    border-block-end-color: var(--t-line);
  }

  .routes-practical {
    margin: clamp(3rem, 6vw, 5rem) 0 0;
    padding: 0;
    list-style: none;
    border-block-start: 1px solid var(--t-line);
  }

  .routes-practical li {
    border-block-end: 1px solid var(--t-line);
  }

  .routes-practical-link {
    display: grid;
    grid-template-columns: minmax(8rem, 2fr) minmax(0, 5fr) auto;
    align-items: baseline;
    gap: 1.5rem;
    padding-block: 1.1rem;
    text-decoration: none;
    color: inherit;
  }

  .routes-practical-label {
    font-size: 1.05rem;
    font-weight: 600;
    transition: color 0.2s ease;
  }

  .routes-practical-detail {
    font-size: var(--t-small);
    color: var(--t-mute);
  }

  .routes-practical-arrow {
    color: var(--t-mute);
    transition: transform 0.2s ease, color 0.2s ease;
  }

  .routes-practical-link:hover .routes-practical-label,
  .routes-practical-link:focus-visible .routes-practical-label {
    color: var(--t-signal);
  }

  .routes-practical-link:hover .routes-practical-arrow,
  .routes-practical-link:focus-visible .routes-practical-arrow {
    color: var(--t-signal);
    transform: translateX(0.3rem);
  }

  .routes-colophon {
    margin-block-start: clamp(2.5rem, 5vw, 4rem);
  }

  @media (min-width: 60rem) {
    .routes-primary {
      grid-template-columns: 1.1fr 0.9fr;
    }
  }

  @media (width < 44rem) {
    .routes-practical-link {
      grid-template-columns: 1fr auto;
      row-gap: 0.3rem;
    }

    .routes-practical-detail {
      grid-column: 1 / -1;
    }
  }
</style>
