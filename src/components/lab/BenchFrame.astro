---
// Shared visual language for the "Bench & Booth" register, introduced for
// Week 6 and reused course-wide: a "test bench" reading built from the
// site's existing --at-* tokens plus one new scoped palette (below). Wrap a
// lecture page's body in this once; every BenchBand/lab/diagram component
// assumes these classes/tokens exist. `week` and `topic` drive the status
// strip's "SLOP2186 · WK06 · NONLINEARITY" readout — defaulted to Week 6's
// original values so that page needs no prop changes.
interface Props {
  week?: number;
  topic?: string;
}

const { week = 6, topic = "NONLINEARITY" } = Astro.props;
const weekCode = `WK${String(week).padStart(2, "0")}`;
---

<div class="bench-frame">
  <div class="bench-status-strip" role="note" aria-label="Course and week identifier">
    <span class="status-dot" aria-hidden="true"></span>
    <span>SLOP2186</span><span class="status-sep" aria-hidden="true">·</span><span>{weekCode}</span><span class="status-sep" aria-hidden="true">·</span><span>{topic}</span>
  </div>
  <slot />
</div>

<style is:global>
  :root {
    /* Bench & Booth's whole theory/bench duality runs on these ~15 custom
       properties (BenchBand and every lab/diagram component reads only
       these, never a raw colour) — so pointing them at the TONE system's
       own tokens re-themes the entire register everywhere it's used,
       without touching BenchBand.astro or any week's content. TONE has no
       light surface, so the "analysis desk" register that used to be a
       warm paper background is now the *calmer* end of TONE's dark scale
       (--t-deep) rather than a literal light page; "bench" sits one step
       up (--t-surface) as the more active instrument-panel register.
       --t-signal (the electrical/measured channel) is the natural read for
       "scope phosphor" — both were already a bright cyan/teal accent. */
    --bench-phosphor: var(--t-signal);
    --bench-input-trace: var(--t-mute);
    --bench-panel-bg: var(--t-surface);
    --bench-panel-bg-raised: var(--t-raised);
    --bench-line: var(--t-line-strong);
    --bench-panel-text: var(--t-paper);
    --bench-panel-text-secondary: var(--t-dim);
    --bench-scan: color-mix(in srgb, var(--t-paper) 14%, transparent);
    --bench-dot: color-mix(in srgb, var(--t-line) 55%, transparent);

    /* The calmer "analysis desk" register: one step further into TONE's
       dark scale than the bench panel, with a dimmer accent so it reads as
       the quieter of the two rather than a second, unrelated palette. */
    --bench-paper-bg: var(--t-deep);
    --bench-paper-bg-raised: var(--t-surface);
    --bench-paper-line: var(--t-line);
    --bench-paper-text: var(--t-dim);
    --bench-paper-text-secondary: var(--t-mute);
    --bench-phosphor-ink: var(--t-signal-dim);

    /* Quiet section-background textures, distinct from --bench-paper-line/
       --bench-scan (which stay unchanged — modules, diagram axes and
       borders still read at their original strength). These are only for
       the full-bleed band background itself, which needed to get quieter
       without touching anything drawn on top of it. */
    --bench-paper-dot: color-mix(in srgb, var(--t-paper) 8%, transparent);
    --bench-scan-band: color-mix(in srgb, var(--t-paper) 6%, transparent);

    /* Corrects the classic 100vw-breakout bug: 100vw includes the browser's
       vertical scrollbar, but the actual visible viewport (and any 100%-wide
       ancestor) does not, so a naive `100vw` full-bleed band ends up wider
       than the page and forces horizontal scrolling. Measuring the gap once
       here lets every full-bleed rule below correct for it. */
    --bench-scrollbar-gutter: calc(100vw - 100%);
  }

  .bench-frame {
    --bench-grid: color-mix(in srgb, var(--at-border) 55%, transparent);
    --bench-readout: var(--at-font-mono);
    /* Base register outside any band is the light "analysis desk" — the
       same read as a .bench-band--theory band, so the status strip above
       the first band doesn't paste a stray white sliver above the paper. */
    --at-bg: var(--bench-paper-bg);
    --at-bg-alt: var(--bench-paper-bg-raised);
    --at-bg-elevated: var(--bench-paper-bg-raised);
    --at-border: var(--bench-paper-line);
    --at-divider: var(--bench-paper-line);
    --at-text: var(--bench-paper-text);
    --at-text-secondary: var(--bench-paper-text-secondary);
    --at-text-muted: var(--bench-paper-text-secondary);
    --at-heading: var(--bench-paper-text);
    --at-accent: var(--bench-phosphor-ink);
    counter-reset: bench-section;
    display: flow-root;
  }

  .bench-status-strip {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--bench-readout);
    font-size: var(--at-font-size-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--at-text-secondary);
    border-bottom: 1px solid var(--bench-paper-line);
    padding-block: 0.6rem;
    margin-block-end: 1.5rem;
  }

  .status-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--bench-phosphor);
    box-shadow: 0 0 5px var(--bench-phosphor);
    flex: none;
  }

  .status-sep {
    color: var(--at-text-muted, var(--at-text-secondary));
  }

  /* Breaks a block out to a wider band than the page's prose column, while
     staying centred on the same axis. There's no theme-provided "wide"
     grid line inside .at-main to opt into (only `body`'s own grid has
     those), so this uses a viewport-relative breakout instead — corrected
     by --bench-scrollbar-gutter so the vertical scrollbar's width doesn't
     push the band wider than the actual visible viewport (the cause of a
     page-level horizontal scrollbar). */
  .bench-frame .bench-wide {
    width: calc(100vw - var(--bench-scrollbar-gutter));
    max-width: min(76rem, 100vw - var(--bench-scrollbar-gutter) - 2 * var(--at-gutter));
    margin-inline: calc(50% - 50vw + var(--bench-scrollbar-gutter) / 2);
    box-sizing: border-box;
  }

  /* Pairs a diagram with a short annotation: side-by-side once there's
     room, stacked below it. Used inside bench bands so prose doesn't just
     sit underneath a diagram at full width, unread. */
  .bench-frame .bench-annotated {
    display: grid;
    gap: 1.5rem;
    align-items: center;
  }

  @media (min-width: 860px) {
    .bench-frame .bench-annotated {
      grid-template-columns: 1.5fr 1fr;
    }
  }

  .bench-frame .bench-eyebrow {
    display: block;
    font-family: var(--bench-readout);
    font-size: var(--at-font-size-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--at-text-secondary);
    margin-bottom: 0.35rem;
  }

  .bench-frame .bench-module {
    border: 1px solid var(--at-border);
    border-radius: var(--at-border-radius);
    background: var(--at-bg-alt);
    background-image:
      linear-gradient(var(--bench-grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--bench-grid) 1px, transparent 1px);
    background-size: 24px 24px;
    background-position: -1px -1px;
    padding: 1.25rem;
  }

  .bench-frame .bench-callout {
    border-left: 3px solid var(--at-accent);
    background: var(--at-bg-alt);
    border-radius: 0 var(--at-border-radius) var(--at-border-radius) 0;
    padding: 0.9rem 1.1rem;
    margin-block: 1.25rem;
  }

  .bench-frame .bench-callout p {
    margin: 0;
  }

  .bench-frame .bench-scope-note {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    font-size: var(--at-font-size-sm);
    color: var(--at-text-secondary);
    border: 1px dashed var(--at-border);
    border-radius: var(--at-border-radius);
    padding: 0.5rem 0.75rem;
    margin-block: 1rem;
  }

  .bench-frame .bench-scope-note::before {
    content: "SCOPE";
    font-family: var(--bench-readout);
    font-size: var(--at-font-size-xs);
    letter-spacing: 0.08em;
    color: var(--at-accent);
    flex: none;
  }

  .bench-frame .bench-prose {
    max-width: 38rem;
  }

  .bench-frame section {
    margin-block: 0;
  }

  /* A lab-notebook margin number beside every h2, living in the same
     gutter the signal rail occupies — one more shared device tying the
     paper and panel bands to the same "instrument" rather than reading
     as two different sites. */
  .bench-frame h2 {
    counter-increment: bench-section;
    position: relative;
    margin-bottom: 0.75rem;
  }

  .bench-frame h2::before {
    content: counter(bench-section, decimal-leading-zero);
    position: absolute;
    right: 100%;
    top: 0.2em;
    padding-inline-end: 0.6rem;
    font-family: var(--bench-readout);
    font-size: var(--at-font-size-xs);
    font-weight: 400;
    letter-spacing: 0;
    color: var(--at-accent);
    opacity: 0.55;
  }

  .bench-frame p {
    line-height: 1.7;
  }
</style>
