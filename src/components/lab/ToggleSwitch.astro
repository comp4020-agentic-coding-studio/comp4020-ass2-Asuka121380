---
// A two-state flip switch backed by a checkbox. Reused for LAB TONE /
// GUITAR SOURCE and PEDAL / ENGINEERING view — "checked" always means the
// second (right-hand) label.
interface Props {
  id: string;
  legend: string;
  offLabel: string;
  onLabel: string;
  checked?: boolean;
}

const { id, legend, offLabel, onLabel, checked = false } = Astro.props;
---

<div class="toggle">
  <span class="t-label" id={`${id}-label`}>{legend}</span>
  <label class="toggle-control">
    <span class="toggle-side" data-side="off">{offLabel}</span>
    <span class="toggle-switch">
      <input type="checkbox" id={id} checked={checked} aria-labelledby={`${id}-label`} />
      <span class="toggle-track" aria-hidden="true">
        <span class="toggle-fill"></span>
      </span>
    </span>
    <span class="toggle-side" data-side="on">{onLabel}</span>
  </label>
</div>

<style>
  .toggle {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .toggle-control {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    cursor: pointer;
  }

  .toggle-side {
    font-family: var(--t-mono);
    font-size: var(--t-label);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--t-mute);
    transition: color 0.15s ease;
  }

  /* A flat two-cell rail, not a pill switch — the active half is filled
     rather than a thumb sliding along a track. */
  .toggle-switch {
    position: relative;
    display: inline-flex;
    width: 2.2rem;
    height: 1rem;
    border: 1px solid var(--t-line-strong);
  }

  .toggle-switch input {
    position: absolute;
    inset: 0;
    opacity: 0;
    margin: 0;
    width: 100%;
    height: 100%;
    cursor: pointer;
  }

  .toggle-track {
    display: block;
    width: 100%;
    height: 100%;
    position: relative;
  }

  .toggle-fill {
    position: absolute;
    inset-block: 0;
    inset-inline-start: 0;
    width: 50%;
    background: var(--t-signal-dim);
    transition: transform 0.15s ease;
  }

  .toggle-switch input:checked ~ .toggle-track .toggle-fill {
    transform: translateX(100%);
  }

  .toggle-switch input:focus-visible ~ .toggle-track {
    outline: 1px solid var(--t-signal);
    outline-offset: 2px;
  }

  .toggle-control:has(input:checked) .toggle-side[data-side="on"],
  .toggle-control:not(:has(input:checked)) .toggle-side[data-side="off"] {
    color: var(--t-paper);
  }
</style>
