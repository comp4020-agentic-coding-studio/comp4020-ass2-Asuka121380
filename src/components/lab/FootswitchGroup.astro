---
// A row of square LED footswitches backed by an ordinary radio-button
// group, replacing a topology <select>. Each native radio stays in the
// accessibility tree (opacity-hidden, not display:none) under a decorative
// LED + label; the group is discovered by its `name` attribute, same as any
// radio group.
interface Option {
  value: string;
  label: string;
}

interface Props {
  name: string;
  legend: string;
  options: Option[];
  selected: string;
}

const { name, legend, options, selected } = Astro.props;
---

<fieldset class="footswitches">
  <legend class="t-label">{legend}</legend>
  <div class="footswitch-row">
    {options.map((option) => (
      <label class="footswitch">
        <input
          type="radio"
          name={name}
          value={option.value}
          checked={option.value === selected}
        />
        <span class="footswitch-face">
          <span class="footswitch-led" aria-hidden="true"></span>
          <span class="footswitch-label">{option.label}</span>
        </span>
      </label>
    ))}
  </div>
</fieldset>

<style>
  .footswitches {
    border: none;
    margin: 0;
    padding: 0;
  }

  .footswitch-row {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .footswitch {
    position: relative;
    cursor: pointer;
  }

  .footswitch input {
    position: absolute;
    inset: 0;
    opacity: 0;
    margin: 0;
    width: 100%;
    height: 100%;
    cursor: pointer;
  }

  /* Square face, no corner radius — a footswitch is a physical square
     button, and TONE has no soft-panel chrome to round it into. */
  .footswitch-face {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    padding: 0.6rem 0.75rem;
    border: 1px solid var(--t-line-strong);
    background: var(--t-surface);
    min-width: 4.5rem;
  }

  .footswitch-led {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--t-edge);
  }

  .footswitch-label {
    font-family: var(--t-mono);
    font-size: var(--t-label);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--t-mute);
  }

  .footswitch input:checked + .footswitch-face {
    border-color: var(--t-signal);
    background: var(--t-raised);
  }

  .footswitch input:checked + .footswitch-face .footswitch-led {
    background: var(--t-signal);
    box-shadow: 0 0 6px var(--t-signal-dim);
  }

  .footswitch input:checked + .footswitch-face .footswitch-label {
    color: var(--t-paper);
  }

  .footswitch input:focus-visible + .footswitch-face {
    outline: 1px solid var(--t-signal);
    outline-offset: 2px;
  }
</style>
