---
// Week 5 "Try It": a single-view gain stage. Turning the Drive knob up from
// its low default sweeps continuously from clean linear amplification
// (output tracks input, just bigger) into audible clipping, and the
// Soft/Hard switch picks which of the two clipping shapes this week
// introduces. This reuses the exact same curve/analysis/audio pipeline as
// Week 6's Nonlinearity Bench (buildClippingCurve, ClippingGraph with a
// plain sine source, no listening chain) — Week 6 revisits this same gain
// stage as a circuit built from real components.
import AudioDemo from "../AudioDemo.astro";
import Spectrum from "../Spectrum.astro";
import Waveform from "../Waveform.astro";
import FootswitchGroup from "./FootswitchGroup.astro";
import Knob from "./Knob.astro";
import { applyCurve, magnitudeSpectrum, sineCycle } from "../../lib/audio/analysis";
import { buildClippingCurve } from "../../lib/audio/waveshaping";
import { transferCurvePath, type Viewport } from "../../lib/draw/svgTrace";

const DEFAULT_TOPOLOGY = "symmetric-soft";
const DEFAULT_DRIVE = 1;

const input = sineCycle(256);
const curve = buildClippingCurve(DEFAULT_TOPOLOGY, DEFAULT_DRIVE);
const output = applyCurve(input, curve);
const spectrum = magnitudeSpectrum(output);

const curveViewport: Viewport = { width: 160, height: 160, padding: 16 };
const curvePadding = curveViewport.padding ?? 0;
const curvePath = transferCurvePath(curve, curveViewport);

const topologyOptions = [
  { value: "symmetric-soft", label: "Soft" },
  { value: "hard", label: "Hard" },
];
---

<div class="gain-bench bench-module" id="gain-bench">
  <div class="lab-header">
    <span class="lab-name">SLOP2186 Gain Bench</span>
    <span class="bench-eyebrow">A sine tone, one gain stage, one clipping shape at a time</span>
  </div>

  <div class="lab-controls">
    <Knob id="gain-drive" label="Drive" min={0.3} max={8} step={0.1} value={DEFAULT_DRIVE} unit="×" />
    <FootswitchGroup name="gain-topology" legend="Clipping shape" options={topologyOptions} selected={DEFAULT_TOPOLOGY} />
    <AudioDemo id="gain-audio" label="Play" />
  </div>

  <div class="lab-body">
    <figure class="curve-panel">
      <svg viewBox={`0 0 ${curveViewport.width} ${curveViewport.height}`} role="img" aria-label="Current transfer curve for the selected drive and clipping shape.">
        <line x1={curvePadding} y1={curveViewport.height / 2} x2={curveViewport.width - curvePadding} y2={curveViewport.height / 2} class="axis" />
        <line x1={curveViewport.width / 2} y1={curvePadding} x2={curveViewport.width / 2} y2={curveViewport.height - curvePadding} class="axis" />
        <path id="gain-transfer-path" d={curvePath} class="curve" fill="none" />
      </svg>
      <figcaption>Transfer curve — input amplitude → output amplitude</figcaption>
    </figure>

    <div class="displays">
      <Waveform id="gain-input-waveform" label="Input" samples={Array.from(input)} strokeVar="--bench-input-trace" />
      <Waveform id="gain-output-waveform" label="Output" samples={Array.from(output)} strokeVar="--bench-phosphor" />
      <Spectrum id="gain-output-spectrum" label="Output spectrum" magnitudes={Array.from(spectrum)} fillVar="--bench-phosphor" />
    </div>
  </div>

  <p class="bench-scope-note">At low drive the output is just a bigger sine — same shape, no new frequencies. Turn Drive up and watch new harmonic bars appear in the spectrum exactly as the waveform starts to flatten.</p>
</div>

<script>
  import { applyCurve, levelCompensation, magnitudeSpectrum, sineCycle } from "../../lib/audio/analysis";
  import { ClippingGraph } from "../../lib/audio/engine";
  import { buildClippingCurve, type ClippingTopology } from "../../lib/audio/waveshaping";
  import { drawSpectrum } from "../../lib/draw/spectrum";
  import { drawWaveform } from "../../lib/draw/waveform";
  import { transferCurvePath } from "../../lib/draw/svgTrace";

  const root = document.getElementById("gain-bench");
  if (root) {
    const topologyRadios = Array.from(
      root.querySelectorAll<HTMLInputElement>('input[name="gain-topology"]'),
    );
    const driveInput = document.getElementById("gain-drive") as HTMLInputElement;
    const inputCanvas = document.getElementById("gain-input-waveform") as HTMLCanvasElement;
    const outputCanvas = document.getElementById("gain-output-waveform") as HTMLCanvasElement;
    const spectrumCanvas = document.getElementById("gain-output-spectrum") as HTMLCanvasElement;
    const curvePathEl = document.getElementById("gain-transfer-path") as unknown as SVGPathElement;
    const toggle = document.getElementById("gain-audio-toggle") as HTMLButtonElement;

    const styles = getComputedStyle(root);
    const inputTrace = styles.getPropertyValue("--bench-input-trace").trim();
    const outputTrace = styles.getPropertyValue("--bench-phosphor").trim() || "#e2b13c";
    const gridColor = styles.getPropertyValue("--bench-line").trim();
    const labelColor = styles.getPropertyValue("--bench-panel-text-secondary").trim();

    const curveViewport = { width: 160, height: 160, padding: 16 };
    const referenceOutput = applyCurve(sineCycle(256), buildClippingCurve("symmetric-soft", 1));

    let graph: ClippingGraph | null = null;

    function currentTopology(): ClippingTopology {
      return (topologyRadios.find((radio) => radio.checked)?.value ??
        "symmetric-soft") as ClippingTopology;
    }

    function stopAudio(): void {
      graph?.stop();
      graph = null;
      (
        window as { setAudioDemoState?: (id: string, playing: boolean) => void }
      ).setAudioDemoState?.("gain-audio", false);
    }

    function redraw(): void {
      const topology = currentTopology();
      const drive = Number(driveInput.value);

      const inputSamples = sineCycle(256);
      const curve = buildClippingCurve(topology, drive);
      const output = applyCurve(inputSamples, curve);
      const spectrum = magnitudeSpectrum(output);
      const compensation = levelCompensation(output, referenceOutput);

      const inputCtx = inputCanvas.getContext("2d");
      if (inputCtx)
        drawWaveform(inputCtx, inputSamples, {
          stroke: inputTrace,
          background: "transparent",
          gridColor,
          labelColor,
        });

      const outputCtx = outputCanvas.getContext("2d");
      if (outputCtx)
        drawWaveform(outputCtx, output, {
          stroke: outputTrace,
          background: "transparent",
          gridColor,
          labelColor,
        });

      const spectrumCtx = spectrumCanvas.getContext("2d");
      if (spectrumCtx)
        drawSpectrum(spectrumCtx, spectrum, {
          fill: outputTrace,
          background: "transparent",
          gridColor,
          labelColor,
        });

      curvePathEl.setAttribute("d", transferCurvePath(curve, curveViewport));

      graph?.setCurve(topology, drive);
      graph?.setLevelCompensation(compensation);
    }

    topologyRadios.forEach((radio) => radio.addEventListener("change", redraw));
    driveInput.addEventListener("input", redraw);

    toggle.addEventListener("click", () => {
      if (graph) {
        stopAudio();
        return;
      }
      const context = new AudioContext();
      graph = new ClippingGraph(context, {
        source: "sine",
        topology: currentTopology(),
        drive: Number(driveInput.value),
      });
      const output = applyCurve(sineCycle(256), buildClippingCurve(currentTopology(), Number(driveInput.value)));
      graph.setLevelCompensation(levelCompensation(output, referenceOutput));
      graph.start();
      (
        window as { setAudioDemoState?: (id: string, playing: boolean) => void }
      ).setAudioDemoState?.("gain-audio", true);
    });

    redraw();
  }
</script>

<style>
  .gain-bench {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .lab-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .lab-name {
    font-family: var(--bench-readout, var(--at-font-mono));
    font-size: var(--at-font-size-sm);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--at-text-secondary);
  }

  .lab-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: center;
    gap: 1.75rem;
  }

  .lab-body {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    align-items: flex-start;
  }

  .curve-panel {
    margin: 0;
    flex: 0 0 10rem;
    max-width: 10rem;
  }

  .curve-panel svg {
    width: 100%;
    height: auto;
    display: block;
    border: 1px solid var(--at-border);
    border-radius: var(--at-border-radius);
    background: var(--at-bg);
  }

  .curve-panel figcaption {
    margin-top: 0.35rem;
    font-size: var(--at-font-size-xs);
    color: var(--at-text-secondary);
  }

  .axis {
    stroke: var(--bench-grid, var(--at-border));
    stroke-width: 1;
  }

  .curve {
    stroke: var(--bench-phosphor);
    stroke-width: 2;
  }

  .displays {
    flex: 1 1 20rem;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(3, 1fr);
  }

  .bench-scope-note {
    margin: 0;
  }

  @media (max-width: 900px) {
    .displays {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .lab-body {
      flex-direction: column;
    }

    .curve-panel {
      max-width: none;
      align-self: center;
      width: 10rem;
    }

    .displays {
      grid-template-columns: 1fr;
    }
  }
</style>
