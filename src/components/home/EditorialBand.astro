---
// A full-bleed homepage section in the Editorial register, alternating
// tone="dark" (warm charcoal, "the stage") and tone="light" (warm cream,
// "the desk") the way Bench & Booth alternates mode="bench"/mode="theory" —
// same idea, different material, so the homepage and the lecture pages feel
// like two rooms in the same building rather than two different sites.
interface Props {
  tone?: "dark" | "light";
  id?: string;
  label?: string;
}

const { tone = "light", id, label } = Astro.props;
---

<section class:list={["editorial-band", `editorial-band--${tone}`]} id={id} aria-label={label}>
  <div class="editorial-band-inner editorial-wide">
    <slot />
  </div>
</section>

<style is:global>
  .editorial-band {
    padding-block: clamp(3rem, 7vw, 6rem);
  }

  .editorial-band--dark {
    background: var(--editorial-charcoal);
    color: var(--editorial-on-charcoal);
  }

  .editorial-band--dark .editorial-kicker,
  .editorial-band--dark h1,
  .editorial-band--dark h2,
  .editorial-band--dark h3 {
    color: var(--editorial-accent);
  }

  .editorial-band--dark a:not([class]) {
    color: var(--editorial-on-charcoal);
  }

  .editorial-band--light {
    background: var(--editorial-paper);
    color: var(--editorial-ink);
  }

  .editorial-band-inner {
    display: flow-root;
  }
</style>
