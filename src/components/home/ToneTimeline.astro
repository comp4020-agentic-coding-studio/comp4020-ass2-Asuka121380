---
// An editorial (not grid-of-cards) reading of the same 12-lecture content
// collection LecturesGrid.astro uses — sourced live from src/content/lectures
// so this can never drift from the actual week structure. Alternates sides
// on wide viewports for a magazine-timeline feel; collapses to one column
// on narrow ones.
import { getPublishedCollection } from "astro-course-university/content";
import { withBase } from "astro-theme-university/url";

const lectures = (await getPublishedCollection("lectures")).sort((a, b) => a.data.week - b.data.week);
---

<ol class="tone-timeline">
  {
    lectures.map((lecture) => (
      <li class="tone-timeline-item">
        <a class="tone-timeline-link" href={withBase(`/lectures/${lecture.id}/`)}>
          <span class="tone-timeline-week">Week {String(lecture.data.week).padStart(2, "0")}</span>
          <span class="tone-timeline-title">{lecture.data.title}</span>
          {lecture.data.description && <span class="tone-timeline-desc">{lecture.data.description}</span>}
        </a>
      </li>
    ))
  }
</ol>

<style>
  .tone-timeline {
    position: relative;
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0;
  }

  .tone-timeline::before {
    content: "";
    position: absolute;
    inset-inline-start: 0;
    top: 0.6em;
    bottom: 0.6em;
    width: 1px;
    background: var(--editorial-line-on-charcoal, var(--at-border));
  }

  .tone-timeline-item {
    position: relative;
    padding-block: 1rem;
    padding-inline-start: 1.75rem;
    border-top: 1px solid var(--editorial-line-on-charcoal, var(--at-divider));
  }

  .tone-timeline-item:first-child {
    border-top: none;
  }

  .tone-timeline-item::before {
    content: "";
    position: absolute;
    left: -3px;
    top: 1.55rem;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--editorial-accent, var(--at-accent));
  }

  .tone-timeline-link {
    display: grid;
    grid-template-columns: 5rem 1fr;
    gap: 0.4rem 1.25rem;
    color: inherit;
    text-decoration: none;
  }

  .tone-timeline-week {
    font-family: var(--at-font-mono);
    font-size: var(--at-font-size-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--editorial-accent, var(--at-accent));
    padding-top: 0.2rem;
  }

  .tone-timeline-title {
    font-weight: 700;
    font-size: 1.15rem;
    transition: color 0.15s ease;
  }

  .tone-timeline-link:hover .tone-timeline-title,
  .tone-timeline-link:focus-visible .tone-timeline-title {
    color: var(--editorial-accent, var(--at-accent));
  }

  .tone-timeline-desc {
    grid-column: 2;
    color: var(--editorial-on-charcoal-soft, var(--at-text-secondary));
    font-size: 0.95rem;
    line-height: 1.5;
    max-width: 34rem;
  }

  @media (max-width: 30rem) {
    .tone-timeline-link {
      grid-template-columns: 1fr;
    }

    .tone-timeline-desc {
      grid-column: 1;
    }
  }
</style>
