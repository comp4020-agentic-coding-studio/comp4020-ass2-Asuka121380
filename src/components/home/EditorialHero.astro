---
// The homepage's opening composition: an asymmetric editorial spread (large
// display title + a real, heavily-cropped guitar photograph), not a boxed
// hero card floating on a page. Warm bone/cream ground, near-black type,
// amber accents — the "editorial/physical" half of the site's two visual
// registers (see EditorialFrame.astro for how this relates to Bench &
// Booth's cyan-phosphor "engineering" register). index.astro renders this
// itself (via BaseLayout, not ContentLayout) precisely so it can take over
// hero markup completely rather than fight the theme's default one.
import { Image } from "astro:assets";
import { withBase } from "astro-theme-university/url";
import type { ImageMetadata } from "astro";

interface Props {
  kicker: string;
  title: string;
  lede: string;
  tags: string[];
  image: ImageMetadata;
}

const { kicker, title, lede, tags, image } = Astro.props;
---

<section class="editorial-hero editorial-wide" aria-label={title}>
  <div class="editorial-hero-copy">
    <p class="editorial-hero-meta">
      <span class="editorial-hero-index">01&ndash;12</span>
      <span class="editorial-hero-kicker">{kicker}</span>
    </p>
    <h1 class="editorial-hero-title">{title}</h1>
    <p class="editorial-hero-lede">{lede}</p>
    <ul class="editorial-hero-tags" aria-label="Course tags">
      {tags.map((tag) => <li>{tag}</li>)}
    </ul>
    <a class="editorial-hero-cta" href="#signal-journey">
      Enter the course
      <span aria-hidden="true">&rarr;</span>
    </a>
  </div>

  <figure class="editorial-hero-figure">
    <Image
      src={image}
      alt="Macro photograph of an electric guitar's fretboard and strings, sharply lit in shallow depth of field."
      widths={[480, 900, 1350]}
      sizes="(max-width: 64rem) 90vw, 40vw"
      format="avif"
      loading="eager"
      fetchpriority="high"
      class="editorial-hero-image"
    />
    <figcaption>Photo: Shixart1985 &middot; CC BY 2.0</figcaption>
  </figure>
</section>

<p class="visually-hidden">
  <a href={withBase("/lectures/")}>Skip the hero and go straight to the lecture list</a>
</p>

<style>
  @import url("https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,380;9..144,600&display=swap");

  .editorial-hero {
    display: grid;
    grid-template-columns: 1fr;
    align-items: center;
    gap: clamp(2rem, 6vw, 3.5rem);
    padding-block: clamp(3rem, 9vw, 6rem) clamp(2.5rem, 6vw, 4rem);
  }

  .editorial-hero-copy {
    max-width: 34rem;
  }

  .editorial-hero-meta {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    margin: 0 0 1.75rem;
    font-family: var(--at-font-mono);
    font-size: var(--at-font-size-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--editorial-ink-soft);
  }

  .editorial-hero-index {
    color: var(--editorial-accent);
    font-size: var(--at-font-size-sm);
  }

  .editorial-hero-kicker {
    position: relative;
    padding-inline-start: 1rem;
  }

  .editorial-hero-kicker::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 0.6rem;
    height: 1px;
    background: currentColor;
    opacity: 0.5;
  }

  .editorial-hero-title {
    font-family: "Fraunces", "Iowan Old Style", "Source Serif 4", Georgia, serif;
    font-optical-sizing: auto;
    font-weight: 600;
    font-size: clamp(2.6rem, 5.6vw, 4.4rem);
    line-height: 0.98;
    letter-spacing: -0.01em;
    margin: 0 0 1.4rem;
    color: var(--editorial-ink);
  }

  .editorial-hero-lede {
    font-size: clamp(1.02rem, 1.4vw, 1.2rem);
    line-height: 1.6;
    color: var(--editorial-ink-soft);
    max-width: 34rem;
    margin: 0 0 1.6rem;
  }

  .editorial-hero-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.75rem;
    padding: 0;
    margin: 0 0 2.25rem;
    list-style: none;
  }

  .editorial-hero-tags li {
    font-family: var(--at-font-mono);
    font-size: var(--at-font-size-xs);
    letter-spacing: 0.04em;
    color: var(--editorial-ink-soft);
  }

  .editorial-hero-tags li:not(:last-child)::after {
    content: "/";
    margin-inline-start: 0.75rem;
    color: var(--editorial-line-on-paper);
  }

  .editorial-hero-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--editorial-ink);
    text-decoration: none;
    font-weight: 600;
    border-bottom: 1px solid var(--editorial-accent);
    padding-block-end: 0.2rem;
    transition: gap 0.2s ease;
  }

  .editorial-hero-cta:hover,
  .editorial-hero-cta:focus-visible {
    gap: 0.9rem;
  }

  .editorial-hero-cta span {
    color: var(--editorial-accent);
  }

  .editorial-hero-figure {
    margin: 0;
    justify-self: center;
    width: min(100%, 26rem);
  }

  .editorial-hero-image {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--editorial-line-on-paper);
  }

  .editorial-hero-figure figcaption {
    margin-top: 0.5rem;
    font-family: var(--at-font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.04em;
    color: var(--editorial-ink-soft);
    opacity: 0.75;
  }

  @media (min-width: 64rem) {
    .editorial-hero {
      grid-template-columns: 1.1fr 0.9fr;
      gap: clamp(2rem, 5vw, 4.5rem);
    }

    .editorial-hero-figure {
      width: 100%;
      justify-self: end;
    }
  }
</style>
