---
// The fixed Analyse → Manipulate → Design progression (see CLAUDE.md /
// SLOP2186.md — not this component's to invent), rendered from the live
// assessments collection so titles, weights and links can't drift from
// src/content/assessments/*.md. Typographic, not three equal boxes: the
// weight itself (25/30/45) is the largest thing on the page, staggered
// vertically so the eye reads it as a rising sequence rather than a row of
// identical cards — per the brief's "card only when the object actually
// behaves like a card" rule, a percentage and a verb don't.
import { getPublishedCollection } from "astro-course-university/content";
import { withBase } from "astro-theme-university/url";

const VERBS = ["Analyse", "Manipulate", "Design"] as const;

const assessments = (await getPublishedCollection("assessments")).sort((a, b) => a.data.week - b.data.week);
---

<ol class="assessment-progression">
  {
    assessments.map((assessment, i) => (
      <li class="assessment-step" style={`--stagger: ${i}`}>
        {i > 0 && (
          <span class="assessment-arrow" aria-hidden="true">
            &rarr;
          </span>
        )}
        <a class="assessment-link" href={withBase(`/assessments/${assessment.id}/`)}>
          <span class="assessment-weight">{assessment.data.weight}<span class="assessment-percent">%</span></span>
          <span class="assessment-verb">{VERBS[i] ?? ""}</span>
          <span class="assessment-title">{assessment.data.title}</span>
        </a>
      </li>
    ))
  }
</ol>

<style>
  .assessment-progression {
    display: flex;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 0 clamp(1rem, 4vw, 3rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .assessment-step {
    display: flex;
    align-items: flex-start;
    gap: clamp(0.75rem, 3vw, 2rem);
    transform: translateY(calc(var(--stagger, 0) * 1.4rem));
  }

  .assessment-arrow {
    align-self: center;
    color: var(--at-text-muted);
    font-size: 1.1rem;
    padding-block-start: 1.5rem;
  }

  .assessment-link {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    color: inherit;
    text-decoration: none;
  }

  .assessment-weight {
    font-family: var(--at-font-mono);
    font-weight: 700;
    font-size: clamp(2.6rem, 6vw, 4rem);
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--editorial-accent, var(--at-accent));
  }

  .assessment-percent {
    font-size: 0.5em;
    margin-inline-start: 0.1em;
  }

  .assessment-verb {
    font-family: var(--at-font-mono);
    font-size: var(--at-font-size-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-block-start: 0.6rem;
    color: var(--editorial-on-charcoal-soft, var(--at-text-secondary));
  }

  .assessment-title {
    font-weight: 700;
    font-size: 1.05rem;
    margin-block-start: 0.15rem;
    border-bottom: 1px solid transparent;
    transition: border-color 0.15s ease;
  }

  .assessment-link:hover .assessment-title,
  .assessment-link:focus-visible .assessment-title {
    border-color: currentColor;
  }

  @media (max-width: 40rem) {
    .assessment-progression {
      flex-direction: column;
      gap: 1.75rem;
    }

    .assessment-step {
      transform: none;
    }
  }
</style>
