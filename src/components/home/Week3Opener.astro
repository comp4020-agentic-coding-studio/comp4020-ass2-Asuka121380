---
// Week 3's own Editorial-mode chapter opener — deliberately NOT LectureIntro
// (used by all 12 weeks; out of scope to modify this phase). This consumes
// the shared EditorialFrame/EditorialBand exactly as LectureIntro does, and
// reproduces LectureIntro's own closing "-> ENTERING THE BENCH" transition
// marker locally (same idea, duplicated CSS) rather than touching that
// shared file. Only week-03.mdx imports this component.
import { Image } from "astro:assets";
import EditorialFrame from "./EditorialFrame.astro";
import EditorialBand from "./EditorialBand.astro";
import type { ImageMetadata } from "astro";

interface Props {
  week: number;
  topic: string;
  title: string;
  image: ImageMetadata;
}

const { week, topic, title, image } = Astro.props;
const weekCode = `WK${String(week).padStart(2, "0")}`;
---

<EditorialFrame>
  <EditorialBand tone="dark" label={`Week ${week} introduction`}>
    <div class="week3-opener">
      <div class="week3-opener-copy">
        <p class="editorial-kicker">SLOP2186 &middot; {weekCode} &middot; {topic}</p>
        <div class="week3-opener-heading">
          <span class="week3-opener-index" aria-hidden="true">03</span>
          <h1 class="week3-opener-title">{title}</h1>
        </div>
        <div class="week3-opener-body">
          <slot />
        </div>
      </div>

      <figure class="week3-opener-figure">
        <Image
          src={image}
          alt="Close-up photograph of humbucker and single-coil guitar pickups mounted on a pickguard."
          widths={[420, 760]}
          sizes="(max-width: 56rem) 85vw, 32rem"
          format="avif"
          loading="eager"
          class="week3-opener-image"
        />
        <ul class="week3-opener-annotations" aria-hidden="true">
          <li style="--x: 12%; --y: 14%;">STRING MOTION</li>
          <li style="--x: 66%; --y: 8%;">MAGNETIC FIELD</li>
          <li style="--x: 74%; --y: 62%;">COIL</li>
          <li style="--x: 18%; --y: 80%;">INDUCED VOLTAGE</li>
        </ul>
        <figcaption>Photo: Feitscherg &middot; Public domain</figcaption>
      </figure>
    </div>
  </EditorialBand>

  <p class="week3-transition-marker" aria-hidden="true">
    <span class="week3-transition-arrow">&rarr;</span> ENTERING THE BENCH
  </p>
</EditorialFrame>

<style>
  @import url("https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,380;9..144,600&display=swap");

  .week3-opener {
    display: grid;
    grid-template-columns: 1fr;
    align-items: start;
    gap: clamp(2rem, 5vw, 3.5rem);
  }

  .week3-opener-copy {
    max-width: 34rem;
  }

  .week3-opener-heading {
    display: flex;
    align-items: baseline;
    gap: 1.25rem;
    margin-block: 1rem 1.5rem;
  }

  .week3-opener-index {
    font-family: "Fraunces", "Iowan Old Style", "Source Serif 4", Georgia, serif;
    font-weight: 380;
    font-size: clamp(2.6rem, 6vw, 4rem);
    line-height: 1;
    color: var(--editorial-accent);
    opacity: 0.85;
  }

  .week3-opener-title {
    font-family: "Fraunces", "Iowan Old Style", "Source Serif 4", Georgia, serif;
    font-optical-sizing: auto;
    font-weight: 600;
    font-size: clamp(2rem, 4.4vw, 3.2rem);
    line-height: 1.05;
    letter-spacing: -0.01em;
    margin: 0;
  }

  .week3-opener-body :global(h2) {
    font-size: clamp(1.4rem, 2.2vw, 1.9rem);
    line-height: 1.25;
    max-width: 34rem;
  }

  .week3-opener-body :global(.lecture-connection) {
    max-width: 34rem;
    color: var(--editorial-on-charcoal-soft);
    font-size: var(--at-font-size-sm);
  }

  .week3-opener-figure {
    position: relative;
    margin: 0;
    width: min(100%, 28rem);
    justify-self: center;
  }

  .week3-opener-image {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border: 1px solid var(--editorial-line-on-charcoal);
  }

  .week3-opener-annotations {
    position: absolute;
    inset: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .week3-opener-annotations li {
    position: absolute;
    left: var(--x);
    top: var(--y);
    font-family: var(--at-font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    color: var(--bench-phosphor, var(--editorial-accent));
    background: color-mix(in oklch, var(--editorial-charcoal) 78%, transparent);
    padding: 0.15rem 0.4rem;
    white-space: nowrap;
  }

  .week3-opener-figure figcaption {
    margin-top: 0.5rem;
    font-family: var(--at-font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.04em;
    color: var(--editorial-on-charcoal-soft);
    opacity: 0.75;
  }

  .week3-transition-marker {
    margin: 0;
    padding-block: 1.1rem;
    text-align: center;
    font-family: var(--at-font-mono);
    font-size: var(--at-font-size-xs);
    letter-spacing: 0.14em;
    color: var(--bench-phosphor-ink, var(--editorial-accent));
    background: linear-gradient(to bottom, var(--editorial-charcoal), var(--bench-paper-bg, var(--editorial-paper)) 92%);
  }

  .week3-transition-arrow {
    display: inline-block;
    animation: week3-transition-nudge 1.6s ease-in-out infinite;
  }

  @keyframes week3-transition-nudge {
    0%,
    100% {
      transform: translateX(0);
    }
    50% {
      transform: translateX(3px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .week3-transition-arrow {
      animation: none;
    }
  }

  @media (min-width: 56rem) {
    .week3-opener {
      grid-template-columns: 1.2fr 0.8fr;
    }

    .week3-opener-figure {
      width: 100%;
      justify-self: end;
    }
  }
</style>
