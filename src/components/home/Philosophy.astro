---
// The course philosophy, verbatim in spirit from CLAUDE.md/SLOP2186.md,
// given an editorial pull-quote treatment rather than another paragraph of
// body text — this idea is the one thing the whole site is arguing for.
// "Waveform / spectral consequence" is shown, not just named: the same
// standard triangular-pluck harmonic model used elsewhere on the site
// (Fletcher & Rossing) generates one real time-domain trace and its real
// magnitude spectrum, so the chain step reads as an actual pair of plots
// rather than another label.
import { harmonicSeriesCycle, magnitudeSpectrum, pluckHarmonicWeights } from "../../lib/audio/analysis";
import { waveformPath, type Viewport } from "../../lib/draw/svgTrace";

const CHAIN = ["Physical mechanism", "Signal transformation", "Waveform / spectral consequence", "Audible consequence"];

const viewport: Viewport = { width: 160, height: 70, padding: 6 };
const waveform = harmonicSeriesCycle(pluckHarmonicWeights(0.2, 8), 128);
const tracePath = waveformPath(waveform, viewport);
// magnitudeSpectrum returns a Float64Array; Array.from first, since
// TypedArray#map coerces each callback's return value to a number and would
// silently turn the JSX below into a garbage numeric array.
const spectrum = Array.from(magnitudeSpectrum(waveform, 16));
---

<div class="philosophy">
  <blockquote class="philosophy-quote">
    Guitar tone is an engineering system, not a set of vibes.
  </blockquote>
  <p class="philosophy-body">
    Every week reasons through the same causal chain, and pushes past subjective language — "warm", "bright",
    "aggressive" — toward what physically or electrically changed, and what that did to the waveform, the spectrum,
    or the sound in time.
  </p>
  <div class="philosophy-evidence">
    <figure class="philosophy-plot">
      <svg viewBox={`0 0 ${viewport.width} ${viewport.height}`} role="img" aria-label="A plucked-string waveform: the time-domain consequence of the physical mechanism above.">
        <path d={tracePath} class="philosophy-trace" fill="none" />
      </svg>
      <figcaption>Waveform</figcaption>
    </figure>
    <figure class="philosophy-plot">
      <svg viewBox={`0 0 ${viewport.width} ${viewport.height}`} role="img" aria-label="The same signal's magnitude spectrum: its energy spread across harmonics.">
        {
          spectrum.map((mag, i) => {
            const barWidth = (viewport.width - 12) / spectrum.length;
            const x = 6 + i * barWidth;
            const h = mag * (viewport.height - 16);
            return <rect x={x + 1} y={viewport.height - 8 - h} width={Math.max(barWidth - 2, 1)} height={h} class="philosophy-bar" />;
          })
        }
        <line x1="6" y1={viewport.height - 8} x2={viewport.width - 6} y2={viewport.height - 8} class="philosophy-axis" />
      </svg>
      <figcaption>Spectrum</figcaption>
    </figure>
    <p class="philosophy-evidence-note">
      One plucked-string model (Fletcher &amp; Rossing's textbook triangular-pluck series) plotted as both a waveform
      and a spectrum — the same signal, two views, not two different things.
    </p>
  </div>
  <ol class="philosophy-chain">
    {
      CHAIN.map((step, i) => (
        <li>
          <span class="philosophy-chain-index">{i + 1}</span>
          <span>{step}</span>
        </li>
      ))
    }
  </ol>
</div>

<style>
  .philosophy {
    max-width: 46rem;
  }

  .philosophy-quote {
    margin: 0 0 1.25rem;
    font-size: clamp(1.6rem, 3.5vw, 2.4rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  .philosophy-body {
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--editorial-on-charcoal-soft, var(--at-text-secondary));
    margin-block-end: 2rem;
  }

  .philosophy-evidence {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 1rem 1.5rem;
    margin-block-end: 2rem;
    padding-block: 1.25rem;
    border-block: 1px solid var(--editorial-line-on-charcoal, var(--at-border));
  }

  .philosophy-plot {
    margin: 0;
    flex: 0 0 9rem;
    width: 9rem;
  }

  .philosophy-plot svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .philosophy-plot figcaption {
    margin-top: 0.3rem;
    font-family: var(--at-font-mono);
    font-size: var(--at-font-size-xs);
    letter-spacing: 0.04em;
    color: var(--editorial-accent, var(--at-accent));
  }

  .philosophy-trace {
    stroke: var(--editorial-accent, var(--at-accent));
    stroke-width: 2;
  }

  .philosophy-bar {
    fill: var(--editorial-accent, var(--at-accent));
  }

  .philosophy-axis {
    stroke: var(--editorial-on-charcoal-soft, var(--at-text-secondary));
    stroke-width: 1;
  }

  .philosophy-evidence-note {
    flex: 1 1 14rem;
    margin: 0;
    font-size: var(--at-font-size-xs);
    line-height: 1.5;
    color: var(--editorial-on-charcoal-soft, var(--at-text-secondary));
  }

  .philosophy-chain {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 0;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: none;
  }

  .philosophy-chain li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex: 1 1 12rem;
    font-size: var(--at-font-size-sm);
    padding-inline-end: 1rem;
  }

  .philosophy-chain-index {
    flex: none;
    width: 1.6rem;
    height: 1.6rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    border: 1px solid var(--editorial-accent, var(--at-accent));
    color: var(--editorial-accent, var(--at-accent));
    font-family: var(--at-font-mono);
    font-size: 0.75rem;
  }

  .philosophy-chain li:not(:last-child)::after {
    content: "→";
    margin-inline-start: 0.6rem;
    color: var(--at-text-muted);
  }

  @media (max-width: 40rem) {
    .philosophy-chain li:not(:last-child)::after {
      display: none;
    }
  }
</style>
