---
// The "Editorial" register: a cinematic, magazine-style reading of the same
// brand hue the rest of the site already uses (--at-primary is Slop
// University's gold, see astro-theme-slop/slop.css) rather than a second,
// unrelated palette. Warm charcoal stands in for Bench & Booth's dark
// "panel" bands and warm cream for its light "paper" bands, so the homepage
// reads as a distinct but related register — not a third, disconnected
// design system. Wrap the whole homepage body in this once; EditorialBand
// and every home/* component assume these tokens exist.
---

<div class="editorial-frame">
  <slot />
</div>

<style is:global>
  .editorial-frame {
    /* This register's only remaining consumer is LectureIntro's opening
       overture (see that file), which always uses the "dark" tone — so
       these tokens now point at the TONE system rather than the homepage's
       pre-redesign brand-gold palette, keeping the overture and the
       Bench & Booth body it leads into reading as one instrument. TONE has
       no light surface, so the "paper" half collapses into the same dark
       scale as everything else (unused in practice while only the dark
       tone is called, kept correct rather than deleted for the interface). */
    --editorial-ink: var(--t-dim);
    --editorial-ink-soft: var(--t-mute);
    --editorial-paper: var(--t-deep);
    --editorial-paper-raised: var(--t-surface);
    --editorial-charcoal: var(--t-void);
    --editorial-charcoal-raised: var(--t-surface);
    --editorial-on-charcoal: var(--t-paper);
    --editorial-on-charcoal-soft: var(--t-dim);
    --editorial-line-on-paper: var(--t-line);
    --editorial-line-on-charcoal: var(--t-line-strong);
    --editorial-accent: var(--t-signal);
    --editorial-accent-soft: var(--t-signal-glow);

    /* Same 100vw-scrollbar correction Bench & Booth uses for its own
       full-bleed bands (see BenchFrame.astro) — reproduced locally so this
       register doesn't depend on Bench markup being present on the page. */
    --editorial-scrollbar-gutter: calc(100vw - 100%);

    /* Base register is the light "desk" read, matching an .editorial-band
       that opens on tone="light" so there's no seam before the first band. */
    --at-bg: var(--editorial-paper);
    --at-bg-alt: var(--editorial-paper-raised);
    --at-bg-elevated: var(--editorial-paper-raised);
    --at-border: var(--editorial-line-on-paper);
    --at-divider: var(--editorial-line-on-paper);
    --at-text: var(--editorial-ink);
    --at-text-secondary: var(--editorial-ink-soft);
    --at-text-muted: var(--editorial-ink-soft);
    --at-heading: var(--editorial-ink);
    --at-accent: var(--editorial-accent);
    display: flow-root;
  }

  .editorial-frame .editorial-wide {
    width: calc(100vw - var(--editorial-scrollbar-gutter));
    max-width: min(90rem, 100vw - var(--editorial-scrollbar-gutter) - 2 * var(--at-gutter));
    margin-inline: calc(50% - 50vw + var(--editorial-scrollbar-gutter) / 2);
    box-sizing: border-box;
  }

  .editorial-frame .editorial-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--at-font-mono);
    font-size: var(--at-font-size-xs);
    text-transform: uppercase;
    letter-spacing: 0.16em;
  }

  .editorial-frame .editorial-kicker::before {
    content: "";
    width: 1.5rem;
    height: 1px;
    background: currentColor;
    opacity: 0.6;
  }

  .editorial-frame .editorial-callout {
    border-left: 3px solid var(--editorial-accent);
    background: var(--editorial-paper-raised);
    border-radius: 0 var(--at-border-radius) var(--at-border-radius) 0;
    padding: 0.9rem 1.1rem;
    margin-block: 1.25rem;
    color: var(--editorial-ink);
  }

  .editorial-frame .editorial-band--dark .editorial-callout {
    background: var(--editorial-charcoal-raised);
    color: var(--editorial-on-charcoal);
  }

  .editorial-frame .editorial-callout p {
    margin: 0;
  }

  .editorial-frame .editorial-scope-note {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    font-size: var(--at-font-size-sm);
    color: var(--editorial-ink-soft);
    border: 1px dashed var(--editorial-line-on-paper);
    border-radius: var(--at-border-radius);
    padding: 0.5rem 0.75rem;
    margin-block: 1rem;
  }

  .editorial-frame .editorial-band--dark .editorial-scope-note {
    color: var(--editorial-on-charcoal-soft);
    border-color: var(--editorial-line-on-charcoal);
  }

  .editorial-frame .editorial-scope-note::before {
    content: "SCOPE";
    font-family: var(--at-font-mono);
    font-size: var(--at-font-size-xs);
    letter-spacing: 0.08em;
    color: var(--editorial-accent);
    flex: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .editorial-frame * {
      animation-duration: 0.001ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.001ms !important;
      scroll-behavior: auto !important;
    }
  }
</style>
