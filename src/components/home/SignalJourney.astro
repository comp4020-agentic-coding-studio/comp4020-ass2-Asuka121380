---
// The homepage's compact signal-chain visual: STRING -> PICKUP -> CIRCUIT ->
// AMP -> SPEAKER -> EAR, six macro-stages rather than twelve boxed cards (the
// detailed week-by-week list already lives further down the page, in
// ToneTimeline, sourced live from the lectures collection — this component's
// only job is to make the whole system readable in one glance, right under
// the hero). Each stage is a link into a representative week. Colour marks
// the physical/electrical transitions the brief's "MUSIC ON THE SURFACE.
// ENGINEERING UNDERNEATH." idea describes: amber where the signal is still
// physical (a string moving, a speaker moving air, a listener perceiving),
// cyan — the same --bench-phosphor hue Bench & Booth already uses for
// "active signal" everywhere else on the site — where it is electrical.
import { withBase } from "astro-theme-university/url";

interface Stage {
  label: string;
  detail: string;
  slug: string;
  domain: "physical" | "signal";
  glyph: "string" | "pickup" | "circuit" | "amp" | "speaker" | "ear";
}

const STAGES: Stage[] = [
  { label: "String", detail: "A plucked string vibrates.", slug: "week-01", domain: "physical", glyph: "string" },
  { label: "Pickup", detail: "Motion becomes a voltage.", slug: "week-03", domain: "signal", glyph: "pickup" },
  { label: "Circuit", detail: "Passive tone and volume reshape it.", slug: "week-04", domain: "signal", glyph: "circuit" },
  { label: "Amp", detail: "Gain, clipping and filtering push it further.", slug: "week-05", domain: "signal", glyph: "amp" },
  { label: "Speaker", detail: "A cabinet turns it back into moving air.", slug: "week-11", domain: "physical", glyph: "speaker" },
  { label: "Ear", detail: "A listener perceives the result as tone.", slug: "week-12", domain: "physical", glyph: "ear" },
];

const GLYPHS: Record<Stage["glyph"], string> = {
  string: '<path d="M1 12 Q6 3 12 12 T23 12" fill="none" stroke-width="1.6"/>',
  pickup: '<circle cx="12" cy="12" r="3" fill="none" stroke-width="1.6"/><circle cx="12" cy="12" r="7.5" fill="none" stroke-width="1.6" opacity="0.55"/>',
  circuit: '<path d="M1 12h4l2-5 4 10 4-10 2 5h4" fill="none" stroke-width="1.6" stroke-linejoin="round"/>',
  amp: '<path d="M2 18 L14 6 L14 18 Z" fill="none" stroke-width="1.6" stroke-linejoin="round"/><path d="M16 9v6M19 7v10M22 10v4" stroke-width="1.4"/>',
  speaker: '<path d="M3 9h4l6-5v16l-6-5H3z" fill="none" stroke-width="1.6" stroke-linejoin="round"/><path d="M17 8a6 6 0 0 1 0 8" fill="none" stroke-width="1.4"/>',
  ear: '<path d="M9 20c-3-2-5-6-5-9a8 8 0 1 1 12 7c-1 1-1 3-1 4a2.5 2.5 0 0 1-5 0" fill="none" stroke-width="1.6" stroke-linecap="round"/>',
};
---

<div class="signal-chain">
  <p class="signal-chain-caption">
    One signal, six stages, string to ear. Physical mechanism becomes electrical signal, and back again.
  </p>
  <ol class="signal-chain-row">
    {
      STAGES.map((stage, i) => (
        <li class:list={["signal-chain-stage", `signal-chain-stage--${stage.domain}`]}>
          <a href={withBase(`/lectures/${stage.slug}/`)} class="signal-chain-link">
            <span class="signal-chain-glyph" aria-hidden="true" set:html={`<svg viewBox="0 0 24 24">${GLYPHS[stage.glyph]}</svg>`} />
            <span class="signal-chain-text">
              <span class="signal-chain-label">{stage.label}</span>
              <span class="signal-chain-detail">{stage.detail}</span>
            </span>
          </a>
          {i < STAGES.length - 1 && <span class="signal-chain-arrow" aria-hidden="true">&rarr;</span>}
        </li>
      ))
    }
  </ol>
</div>

<style>
  .signal-chain-caption {
    max-width: 34rem;
    color: var(--at-text-secondary);
    margin: 0 0 2rem;
  }

  .signal-chain-row {
    display: flex;
    align-items: stretch;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--editorial-line-on-paper, var(--at-border));
  }

  .signal-chain-stage {
    display: flex;
    align-items: center;
    flex: 1 1 0;
    min-width: 0;
  }

  .signal-chain-link {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex: 1;
    min-width: 0;
    padding-block: 1.1rem;
    color: inherit;
    text-decoration: none;
  }

  .signal-chain-glyph {
    flex: none;
    display: block;
    width: 1.6rem;
    height: 1.6rem;
  }

  .signal-chain-glyph svg {
    width: 100%;
    height: 100%;
    stroke: var(--editorial-accent, var(--at-accent));
    transition: stroke 0.15s ease;
  }

  .signal-chain-stage--signal .signal-chain-glyph svg {
    stroke: var(--bench-phosphor, var(--editorial-accent));
  }

  .signal-chain-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .signal-chain-label {
    font-weight: 700;
    font-size: 0.95rem;
    letter-spacing: 0.01em;
  }

  .signal-chain-detail {
    font-size: 0.78rem;
    line-height: 1.35;
    color: var(--at-text-secondary);
    overflow-wrap: break-word;
  }

  .signal-chain-link:hover .signal-chain-label,
  .signal-chain-link:focus-visible .signal-chain-label {
    text-decoration: underline;
    text-decoration-color: var(--editorial-accent, var(--at-accent));
  }

  .signal-chain-arrow {
    flex: none;
    padding-inline: 0.6rem;
    color: var(--at-text-muted);
    align-self: center;
    font-size: 0.85rem;
    opacity: 0.6;
  }

  @media (max-width: 56rem) {
    .signal-chain-row {
      flex-direction: column;
      border-top: none;
    }

    .signal-chain-stage {
      border-top: 1px solid var(--editorial-line-on-paper, var(--at-border));
    }

    .signal-chain-arrow {
      display: none;
    }
  }
</style>
