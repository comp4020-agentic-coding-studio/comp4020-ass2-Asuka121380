---
// "Hear the Difference": one source, three processing chains, so the only
// variable between presets is the signal chain itself — the same principle
// CLAUDE.md's audio policy asks every guitar-specific demo to follow. This
// reuses CompleteChainGraph exactly as Week 12's CompleteChainBench does
// (same canonical DI guitar recording, same engine, same never-autoplay
// AudioDemo control); it presets three fixed points along that chain rather
// than exposing the full control surface, since the homepage's job is to
// make the idea audible in ten seconds, not to teach every parameter.
import AudioDemo from "../AudioDemo.astro";
import type { CompleteChainOptions } from "../../lib/audio/engine";

interface Preset {
  id: string;
  name: string;
  description: string;
  params: Omit<CompleteChainOptions, "onEnded">;
}

const PRESETS: Preset[] = [
  {
    id: "hear-clean",
    name: "Clean",
    description: "Neck pickup, bright EQ, almost no gain — the string's own shape, barely touched.",
    params: {
      pickupPosition: "neck",
      eqCutoffHz: 6000,
      eqPosition: "pre",
      drive: 0.5,
      topology: "symmetric-soft",
      modulationOn: false,
      modulationDepth: 0,
      delayMode: "off",
      delayAmount: 0,
      ampDrive: 0.6,
      ampToneHz: 5000,
      cabinetProfile: "flat",
    },
  },
  {
    id: "hear-driven",
    name: "Driven",
    description: "Bridge pickup, darker EQ, asymmetric clipping and a driven amplifier stage.",
    params: {
      pickupPosition: "bridge",
      eqCutoffHz: 3000,
      eqPosition: "pre",
      drive: 4,
      topology: "asymmetric-soft",
      modulationOn: false,
      modulationDepth: 0,
      delayMode: "off",
      delayAmount: 0,
      ampDrive: 3,
      ampToneHz: 2400,
      cabinetProfile: "dark",
    },
  },
  {
    id: "hear-full",
    name: "Full chain",
    description: "Fuzz clipping, modulation, reverb and a resonant cabinet — every stage engaged at once.",
    params: {
      pickupPosition: "bridge",
      eqCutoffHz: 2200,
      eqPosition: "post",
      drive: 6,
      topology: "fuzz",
      modulationOn: true,
      modulationDepth: 0.5,
      delayMode: "reverb",
      delayAmount: 0.55,
      ampDrive: 4,
      ampToneHz: 2000,
      cabinetProfile: "resonant",
    },
  },
];
---

<div class="hear-difference" id="hear-difference" data-presets={JSON.stringify(PRESETS.map((p) => ({ id: p.id, params: p.params })))}>
  <div class="hear-grid">
    {
      PRESETS.map((preset, i) => (
        <div class="hear-card">
          <p class="hear-channel">CH.{String(i + 1).padStart(2, "0")}</p>
          <h3>{preset.name}</h3>
          <p>{preset.description}</p>
          <AudioDemo id={preset.id} label={`Play “${preset.name}”`} />
        </div>
      ))
    }
  </div>
  <p class="hear-note">
    Same DI guitar recording through three different signal chains — same performance, different processing,
    different tone. (This is the course's one canonical dry recording, the same source every guitar-specific
    lab on the site uses; see Week 5 onward for exactly what changes at each stage.)
  </p>
</div>

<script>
  import type { CompleteChainOptions } from "../../lib/audio/engine";
  import { CompleteChainGraph } from "../../lib/audio/engine";

  interface PresetData {
    id: string;
    params: Omit<CompleteChainOptions, "onEnded">;
  }

  const root = document.getElementById("hear-difference");
  if (root) {
    const presets: PresetData[] = JSON.parse(root.dataset.presets ?? "[]");
    let context: AudioContext | null = null;
    let activeGraph: CompleteChainGraph | null = null;
    let activeId: string | null = null;

    function setState(id: string, playing: boolean): void {
      (window as { setAudioDemoState?: (id: string, playing: boolean) => void }).setAudioDemoState?.(id, playing);
    }

    function stopActive(): void {
      if (activeGraph) activeGraph.stop();
      if (activeId) setState(activeId, false);
      activeGraph = null;
      activeId = null;
    }

    for (const preset of presets) {
      const toggle = document.getElementById(`${preset.id}-toggle`) as HTMLButtonElement | null;
      if (!toggle) continue;

      toggle.addEventListener("click", async () => {
        const wasActive = activeId === preset.id;
        stopActive();
        if (wasActive) return;

        context = context ?? new AudioContext();
        const graph = new CompleteChainGraph(context, {
          ...preset.params,
          onEnded: () => {
            if (activeId === preset.id) {
              activeGraph = null;
              activeId = null;
              setState(preset.id, false);
            }
          },
        });
        activeGraph = graph;
        activeId = preset.id;
        await graph.start();
        if (activeGraph !== graph) return;
        setState(preset.id, true);
      });
    }
  }
</script>

<style>
  .hear-grid {
    display: grid;
    gap: 1.75rem 2rem;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    margin-block-end: 1.5rem;
    padding-block-start: 1.5rem;
    border-block-start: 1px solid var(--editorial-line-on-paper, var(--at-border));
  }

  .hear-card {
    padding-inline-start: 1.1rem;
    border-inline-start: 1px solid var(--editorial-line-on-paper, var(--at-border));
  }

  .hear-channel {
    margin: 0 0 0.35rem;
    font-family: var(--rig-mono, var(--at-font-mono));
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    color: var(--rig-text-muted, var(--at-text-muted));
  }

  .hear-card h3 {
    margin-block: 0 0.4rem;
  }

  .hear-card p {
    margin-block: 0 0.75rem;
    font-size: 0.95rem;
    color: var(--at-text-secondary);
    line-height: 1.5;
  }

  .hear-note {
    font-size: var(--at-font-size-sm);
    color: var(--at-text-secondary);
    max-width: 42rem;
  }
</style>
