---
// One assessment's full brief, in the TONE visual system. The overview page
// (src/pages/assessments/index.astro) carries the weighting and marking
// summary across all three; this page is where a single brief's task
// description, spec and marking detail actually live, so they are written
// once. MarkingModel/SpecList/RelatedContent are the same shared components
// the old editorial page used — their unscoped styles already read the
// --at-* tokens tone.css remaps, so only the surrounding type needs restyling.
import { render } from "astro:content";
import { getPublishedCollection } from "astro-course-university/content";
import RelatedContent from "astro-course-university/components/RelatedContent.astro";
import SpecList from "astro-course-university/components/SpecList.astro";
import BaseLayout from "astro-theme-university/layouts/BaseLayout.astro";
import { withBase } from "astro-theme-university/url";
import MarkingModel from "../../components/MarkingModel.astro";
import { formatCourseDate } from "../../lib/dates";
import { courseMeta } from "../../course-config";
import { graphCollections, siteConfig } from "../../site-config";
import "../../styles/tone.css";

export async function getStaticPaths() {
  const assessments = await getPublishedCollection("assessments");
  return assessments.map((assessment) => ({
    params: { slug: assessment.id },
    props: { assessment },
  }));
}

const { assessment } = Astro.props;
const { Content } = await render(assessment);

const VERBS: Record<string, string> = {
  "tone-autopsy": "Analyse",
  "pedal-laboratory": "Manipulate",
  "engineer-a-guitar-tone": "Design",
};
const STAGES = ["tone-autopsy", "pedal-laboratory", "engineer-a-guitar-tone"];
const stageIndex = STAGES.indexOf(assessment.id);

const relatedWeeks = (assessment.data.related ?? [])
  .map((ref) => {
    const match = /^lectures\/week-(\d+)$/.exec(ref);
    return match ? { href: withBase(`/lectures/${match[0].split("/")[1]}/`), label: `Week ${match[1]}` } : null;
  })
  .filter((w): w is { href: string; label: string } => w !== null);
---

<BaseLayout
  title={`${assessment.data.title} — ${courseMeta.code}`}
  description={assessment.data.description ?? undefined}
  mainAttrs={{ "data-tone": true }}
  {...siteConfig}
  name={courseMeta.code}
  logo={undefined}
  logoDark={undefined}
  logoCompact={undefined}
  logoCompactDark={undefined}
>
  <style
    slot="head"
    is:inline
    set:html={`body{--course-title:${JSON.stringify(courseMeta.title)}}`}
  />

  <div class="t-graticule" aria-hidden="true"></div>

  <div class="t-layer">
    <header class="b-hero t-band">
      <div class="t-shell">
        <a class="t-link b-back" href={withBase("/assessments/")}>
          <span class="t-arrow" aria-hidden="true">&larr;</span> All assessment
        </a>
        <p class="t-label t-label--signal">
          {VERBS[assessment.id] ?? "Assessment"}
        </p>
        <h1 class="t-h1 b-hero-title">{assessment.data.title}</h1>
        <p class="t-lede b-hero-lede">{assessment.data.description}</p>

        {
          assessment.data.draft && (
            <p class="b-draft">
              <strong>Draft.</strong> This brief is still being finalised and
              may change.
            </p>
          )
        }

      </div>
    </header>

    <section class="b-body">
      <div class="t-shell">
        <div class="t-grid b-grid">
          <div class="b-main">
            <div class="b-prose">
              <Content />
            </div>

            <SpecList spec={assessment.data.spec}>
              The brief poses the problem and leaves room for a response. The
              spec is the fixed part: what a marker checks. Some lines can be
              checked mechanically; the rest call for judgement.
            </SpecList>

            {assessment.data.marking && <MarkingModel marking={assessment.data.marking} />}

            <RelatedContent entry={assessment} collections={graphCollections} />
          </div>

          <aside class="b-side">
            <dl class="b-facts">
              <div>
                <dt class="t-label">Due</dt>
                <dd class="t-num">{formatCourseDate(assessment.data.due)}</dd>
              </div>
              <div>
                <dt class="t-label">Weight</dt>
                <dd class="t-num">{assessment.data.weight}%</dd>
              </div>
              <div>
                <dt class="t-label">Week set</dt>
                <dd class="t-num">Week {assessment.data.week}</dd>
              </div>
            </dl>

            <div class="b-side-block">
              <p class="t-label b-side-heading">Expected evidence</p>
              <ul class="b-side-spec" role="list">
                {assessment.data.spec.map((line) => (
                  <li>{line}</li>
                ))}
              </ul>
            </div>

            {relatedWeeks.length > 0 && (
              <div class="b-side-block">
                <p class="t-label b-side-heading">Relevant weeks</p>
                <ul class="b-side-weeks" role="list">
                  {relatedWeeks.map((w) => (
                    <li>
                      <a class="t-link b-side-week-link" href={w.href}>
                        {w.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            <div class="b-side-block">
              <p class="t-label b-side-heading">Progression</p>
              <ol class="b-side-stages" role="list">
                {STAGES.map((id, i) => (
                  <li class:list={["b-side-stage", { "b-side-stage--current": i === stageIndex }]}>
                    <span class="t-num b-side-stage-num">{i + 1}</span>
                    <span class="t-label b-side-stage-verb">{VERBS[id]}</span>
                  </li>
                ))}
              </ol>
            </div>
          </aside>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  const nav = document.querySelector<HTMLElement>(".at-nav");
  if (nav) {
    const sync = () => {
      if (window.scrollY > 24) nav.dataset.scrolled = "";
      else delete nav.dataset.scrolled;
    };
    sync();
    window.addEventListener("scroll", sync, { passive: true });
    document.addEventListener("astro:before-swap", () =>
      window.removeEventListener("scroll", sync),
    );
  }
</script>

<style>
  .b-back {
    margin-block-end: 2rem;
  }

  .b-back .t-arrow {
    transition: transform 0.2s ease;
  }

  .b-back:hover .t-arrow {
    transform: translateX(-0.25rem);
  }

  .b-hero-title {
    max-width: 24ch;
    margin: 0.75rem 0 1.25rem;
  }

  .b-hero-lede {
    max-width: 60ch;
    margin: 0 0 1.75rem;
  }

  .b-draft {
    max-width: 60ch;
    padding: 0.85rem 1.1rem;
    margin: 0 0 1.75rem;
    border: 1px solid var(--t-copper-dim);
    color: var(--t-copper);
    font-size: var(--t-small);
  }

  .b-draft strong {
    color: var(--t-paper);
  }

  .b-body {
    padding-block-end: clamp(4rem, 8vw, 6rem);
  }

  .b-grid {
    row-gap: 3rem;
    align-items: start;
  }

  .b-main {
    grid-column: 1 / 8;
  }

  .b-side {
    grid-column: 9 / 13;
    position: sticky;
    top: clamp(5rem, 10vw, 7rem);
    display: grid;
    gap: 2rem;
  }

  .b-facts {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding-block-end: 1.75rem;
    border-block-end: 1px solid var(--t-line);
  }

  .b-facts > div {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .b-facts dt {
    margin: 0;
  }

  .b-facts dd {
    margin: 0;
    font-size: 1.05rem;
    color: var(--t-paper);
  }

  .b-side-heading {
    color: var(--t-mute);
    margin: 0 0 0.9rem;
  }

  .b-side-spec {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.6rem;
  }

  .b-side-spec li {
    font-size: var(--t-small);
    color: var(--t-dim);
    line-height: 1.5;
    padding-inline-start: 0.9rem;
    border-inline-start: 2px solid var(--t-line-strong);
  }

  .b-side-weeks {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .b-side-week-link {
    font-family: var(--t-mono);
    font-size: var(--t-label);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--t-dim);
    border-block-end-color: var(--t-line);
  }

  .b-side-stages {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.6rem;
  }

  .b-side-stage {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    color: var(--t-mute);
  }

  .b-side-stage-num {
    font-size: 0.8rem;
  }

  .b-side-stage--current {
    color: var(--t-signal);
  }

  .b-side-stage--current .b-side-stage-num {
    color: var(--t-signal);
  }

  .b-prose {
    max-width: var(--t-measure);
    color: var(--t-dim);
  }

  .b-prose :global(h2) {
    font-size: var(--t-h3);
    margin: clamp(2.5rem, 4vw, 3.5rem) 0 1rem;
  }

  .b-prose :global(h2:first-child) {
    margin-block-start: 0;
  }

  .b-prose :global(p),
  .b-prose :global(li) {
    font-size: var(--t-body);
    line-height: 1.65;
  }

  .b-prose :global(ul),
  .b-prose :global(ol) {
    padding-inline-start: 1.25rem;
    display: grid;
    gap: 0.5rem;
  }

  .b-prose :global(strong) {
    color: var(--t-paper);
    font-weight: 600;
  }

  .b-prose :global(a) {
    color: var(--t-signal);
  }

  .b-body :global(.spec-list),
  .b-body :global(section[aria-labelledby="how-marked"]),
  .b-body :global(.related-content) {
    max-width: var(--t-measure);
    padding-block-start: clamp(2.5rem, 4vw, 3rem);
    margin-block-start: clamp(2.5rem, 4vw, 3rem);
    border-block-start: 1px solid var(--t-line);
  }

  .b-body :global(.spec-list h2),
  .b-body :global(section[aria-labelledby="how-marked"] h2),
  .b-body :global(.related-content h2) {
    font-family: var(--t-mono);
    font-size: var(--t-label);
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--t-mute);
    margin: 0 0 1.25rem;
  }

  .b-body :global(.spec-list p) {
    color: var(--t-dim);
    max-width: 60ch;
  }

  .b-body :global(.spec-list ul) {
    display: grid;
    gap: 0.6rem;
    padding-inline-start: 1.25rem;
    color: var(--t-paper);
  }

  .b-body :global(.related-content ul) {
    padding: 0;
  }

  .b-body :global(.related-content a) {
    color: var(--t-signal);
  }

  @media (width < 60rem) {
    .b-main,
    .b-side {
      grid-column: 1 / -1;
    }

    .b-side {
      position: static;
    }
  }
</style>
