---
// Every week opens on its own composition (WeekOpener) rather than
// astro-theme-university's ContentLayout, which would print a generic
// <h1>{title}</h1> + date + lead before any content. `data-tone` on <main>
// is what dismantles the theme's page shell for this route — see
// src/styles/tone.css. This route used to serve every week except week-03,
// which had its own dedicated route so it could carry this composition
// alone; now that the whole course shares it, that split route is gone.
import { render } from "astro:content";
import BaseLayout from "astro-theme-university/layouts/BaseLayout.astro";
import { getPublishedCollection } from "astro-course-university/content";
import RelatedContent from "astro-course-university/components/RelatedContent.astro";
import { withBase } from "astro-theme-university/url";
import TeachingTeam from "../../components/TeachingTeam.astro";
import { formatCourseDate } from "../../lib/dates";
import { courseMeta } from "../../course-config";
import { graphCollections, siteConfig } from "../../site-config";
import "../../styles/tone.css";

export async function getStaticPaths() {
  const lectures = await getPublishedCollection("lectures");
  return lectures.map((lecture) => ({ params: { slug: lecture.id }, props: { lecture } }));
}

const { lecture } = Astro.props;
const { Content } = await render(lecture);
const title = `Week ${lecture.data.week}: ${lecture.data.title}`;
// Lecture frontmatter may carry an ad-hoc `teacherOverrides` map (allowed by
// the collection's loose schema) for a page-local convenor display-name
// override, without touching the People collection or the teachers reference.
const teacherOverrides = (lecture.data as { teacherOverrides?: Record<string, string> }).teacherOverrides;
---

<BaseLayout
  title={title}
  description={lecture.data.description ?? undefined}
  mainAttrs={{ "data-tone": true }}
  {...siteConfig}
  name={courseMeta.code}
  logo={undefined}
  logoDark={undefined}
  logoCompact={undefined}
  logoCompactDark={undefined}
>
  {/* See index.astro: the nav appends the course title via CSS. */}
  <style
    slot="head"
    is:inline
    set:html={`body{--course-title:${JSON.stringify(courseMeta.title)}}`}
  />

  <div class="t-graticule" aria-hidden="true"></div>

  <div class="t-layer">
    <Content />

    {
      /* The date, slides link, teaching team and related content that
         ContentLayout would normally print above the content. The functional
         information is kept; it just stops being the page's opening move. */
    }
    <div class="week-meta">
      <div class="t-shell">
        <dl class="week-meta-facts">
          <div>
            <dt class="t-label">Teaching date</dt>
            <dd>{formatCourseDate(lecture.data.date)}</dd>
          </div>
          {
            lecture.data.slides && (
              <div>
                <dt class="t-label">Slides</dt>
                <dd>
                  <a class="t-link" href={withBase(lecture.data.slides)}>
                    Open the deck <span class="t-arrow" aria-hidden="true">&rarr;</span>
                  </a>
                </dd>
              </div>
            )
          }
        </dl>

        <div class="week-meta-related">
          <TeachingTeam teachers={lecture.data.teachers} nameOverrides={teacherOverrides} />
          <RelatedContent entry={lecture} collections={graphCollections} />
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  const nav = document.querySelector<HTMLElement>(".at-nav");
  if (nav) {
    const sync = () => {
      if (window.scrollY > 24) nav.dataset.scrolled = "";
      else delete nav.dataset.scrolled;
    };
    sync();
    window.addEventListener("scroll", sync, { passive: true });
    document.addEventListener("astro:before-swap", () =>
      window.removeEventListener("scroll", sync),
    );
  }
</script>

<style>
  .week-meta {
    border-block-start: 1px solid var(--t-line);
    padding-block: var(--t-band) clamp(3rem, 6vw, 5rem);
  }

  .week-meta-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 2.5rem;
    margin: 0 0 clamp(2rem, 4vw, 3rem);
  }

  .week-meta-facts dd {
    margin: 0.4rem 0 0;
    font-size: 1.05rem;
    color: var(--t-paper);
  }

  .week-meta-related {
    display: grid;
    gap: clamp(2rem, 4vw, 3rem);
    color: var(--t-dim);
  }

  .week-meta-related :global(h2),
  .week-meta-related :global(h3) {
    font-size: var(--t-label);
    font-family: var(--t-mono);
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--t-mute);
  }

  .week-meta-related :global(a) {
    color: var(--t-paper);
  }

  .week-meta-related :global(a:hover) {
    color: var(--t-signal);
  }

  @media (min-width: 60rem) {
    .week-meta-related {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
