---
// The Homepage: "a guitar signal-processing environment that happens to
// teach a university course" (CLAUDE.md's signal-processing-environment
// revision). Renders through RigFrame — a new, homepage-exclusive register,
// deliberately not EditorialFrame/EditorialBand (shared with assessments/
// people/policies/sessions, which stay in the previous register for now).
// One continuous dark workspace, not alternating light/dark "bands":
// hero -> signal-chain navigation -> tone analysis -> hear the difference
// -> assessment chain -> practical links.
import BaseLayout from "astro-theme-university/layouts/BaseLayout.astro";
import heroImage from "../assets/images/hero-guitar-strings.jpg";
import { courseMeta } from "../course-config";
import { siteConfig } from "../site-config";
import RigFrame from "../components/rig/RigFrame.astro";
import RigHero from "../components/rig/RigHero.astro";
import SignalChainNav from "../components/rig/SignalChainNav.astro";
import ToneAnalysis from "../components/rig/ToneAnalysis.astro";
import HearTheDifference from "../components/home/HearTheDifference.astro";
import AssessmentChain from "../components/rig/AssessmentChain.astro";
import PracticalLinks from "../components/home/PracticalLinks.astro";
---

<BaseLayout
  title={`${courseMeta.code}: ${courseMeta.title}`}
  description={courseMeta.description}
  {...siteConfig}
>
  <RigFrame>
    <RigHero
      eyebrow={`${courseMeta.code} · ${courseMeta.session} ${courseMeta.year}`}
      title={courseMeta.title}
      lede="Follow one guitar signal from a plucked string to a listener's ear, one stage at a time — string, pickup, circuit, gain, clipping, filtering, modulation, delay and reverb, amplifier, and speaker. No electronics or DSP background assumed; every stage builds its own vocabulary from a waveform or a spectrum, not an adjective."
      image={heroImage}
    />

    <section aria-labelledby="signal-chain-heading">
      <p class="rig-eyebrow">The signal chain</p>
      <h2 id="signal-chain-heading">Twelve modules, one rig</h2>
      <SignalChainNav />
    </section>

    <section aria-labelledby="tone-analysis-heading">
      <h2 id="tone-analysis-heading" class="visually-hidden">Course philosophy</h2>
      <ToneAnalysis />
    </section>

    <section aria-labelledby="hear-heading">
      <p class="rig-eyebrow">Hear the difference</p>
      <h2 id="hear-heading">Same source, different processing</h2>
      <HearTheDifference />
    </section>

    <section aria-labelledby="assessment-heading">
      <p class="rig-eyebrow">Analyse &rarr; Manipulate &rarr; Design</p>
      <h2 id="assessment-heading">How you are assessed</h2>
      <AssessmentChain />
    </section>

    <section aria-labelledby="practical-heading">
      <p class="rig-eyebrow">Getting started</p>
      <h2 id="practical-heading">Sessions, people, and policies</h2>
      <PracticalLinks />
    </section>
  </RigFrame>
</BaseLayout>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
