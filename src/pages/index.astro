---
import Card from "astro-theme-university/components/Card.astro";
import CardGrid from "astro-theme-university/components/CardGrid.astro";
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import heroImage from "../assets/images/hero-home.avif";
import { courseMeta } from "../course-config";
import { sessionLabels, siteConfig } from "../site-config";
---

<ContentLayout
  title={`${courseMeta.code}: ${courseMeta.title}`}
  description={courseMeta.description}
  heroImage={heroImage}
  heroImageAlt="A lecture theatre reduced to flat gold and black shapes, rows of seats sweeping past the frame, in a two-ink risograph print"
  {...siteConfig}
>
  <ul class="course-tags" aria-label="Course tags">
    {courseMeta.tags.map((tag) => <li>{tag}</li>)}
  </ul>

  <h2>What you will do</h2>
  <p>
    Follow one guitar signal from a plucked string to a listener's ear, one
    stage at a time: pickup, guitar electronics, gain, clipping, filtering,
    modulation, delay and reverb, amplifier, and speaker cabinet. Every week
    pairs the physical or electrical mechanism with a lab bench that lets you
    change a real parameter and hear and see the consequence — a waveform, a
    spectrum, a frequency response — rather than take it on faith. Across
    three assessments you move from analysing an existing sound, to
    manipulating a simplified pedal circuit, to designing and justifying a
    complete signal chain against a stated tonal target.
  </p>

  <h2>Who it is for</h2>
  <p>
    Anyone curious about why two guitar sounds differ, who wants that
    curiosity answered with physics and signal processing rather than
    adjectives. No electronics or DSP background is assumed — the course
    builds its own vocabulary from Week 1 — but you should be comfortable
    with the idea that a sound can be read off a waveform or a spectrum, and
    willing to reason from a graph rather than a gut feeling.
  </p>

  <h2>Where to go next</h2>
  <CardGrid columns={2}>
    <Card title={sessionLabels.plural} href="/sessions/">
      <p>The weekly schedule and what happens in each teaching session.</p>
    </Card>
    <Card title="Assessment" href="/assessments/">
      <p>What is marked, what it is worth, and when it is due.</p>
    </Card>
    <Card title="People" href="/people/">
      <p>Who teaches the course and how to reach them.</p>
    </Card>
  </CardGrid>
</ContentLayout>

<style>
  .course-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-block: 0 2rem;
    padding: 0;
    list-style: none;
  }

  .course-tags li {
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    color: var(--at-text-secondary);
    background: var(--at-bg-alt);
    font-size: 0.9rem;
  }
</style>
