---
// The Homepage, in the TONE visual system (src/styles/tone.css): one
// continuous instrument surface rather than a course-catalogue page, with the
// course identity — not the institution — as the primary mark in the nav.
//
// `data-tone` on <main> is what dismantles astro-theme-university's page
// shell (its 48rem body grid, its accent rail, its nav column placement) for
// this route only; every page not yet redesigned keeps the theme's layout
// untouched. See src/styles/tone.css for exactly what is undone and why.
//
// The composition alternates deliberately rather than stacking equal
// sections: full-bleed hero, centred method statement, full-bleed signal
// chain, left-heavy listening bench, right-heavy assessment ladder, and a
// closing row of routes in.
import BaseLayout from "astro-theme-university/layouts/BaseLayout.astro";
import { courseMeta } from "../course-config";
import { siteConfig } from "../site-config";
import ToneHero from "../components/tone/ToneHero.astro";
import VocabularyBand from "../components/tone/VocabularyBand.astro";
import SignalChain from "../components/tone/SignalChain.astro";
import ListeningBench from "../components/tone/ListeningBench.astro";
import AssessmentLadder from "../components/tone/AssessmentLadder.astro";
import RoutesIn from "../components/tone/RoutesIn.astro";
import "../styles/tone.css";
---

<BaseLayout
  title={`${courseMeta.code}: ${courseMeta.title}`}
  description={courseMeta.description}
  mainAttrs={{ "data-tone": true }}
  {...siteConfig}
  name={courseMeta.code}
  logo={undefined}
  logoDark={undefined}
  logoCompact={undefined}
  logoCompactDark={undefined}
  acknowledgement={{
    title: "Slop University",
    text: `${courseMeta.code} is a Slop University course. The crest and name are kept out of the nav above so the signal chain stays the subject; this is the one place on the page they appear.`,
    logo: siteConfig.favicon,
    logoAlt: "Slop University crest",
  }}
>
  {
    /* The nav renders the course title after the code via CSS, so it can be
       dropped on its own at narrow widths without the code going with it.
       The string comes from courseMeta rather than being repeated in the
       stylesheet. */
  }
  <style
    slot="head"
    is:inline
    set:html={`body{--course-title:${JSON.stringify(courseMeta.title)}}`}
  />

  <div class="t-graticule" aria-hidden="true"></div>

  <div class="t-layer">
    <ToneHero />
    <VocabularyBand />
    <SignalChain />
    <ListeningBench />
    <AssessmentLadder />
    <RoutesIn />
  </div>
</BaseLayout>

<script>
  // The nav is transparent over the hero and gains a hairline once the page
  // moves, so the header reads as part of the opening composition at rest.
  const nav = document.querySelector<HTMLElement>(".at-nav");
  if (nav) {
    const sync = () => {
      if (window.scrollY > 24) nav.dataset.scrolled = "";
      else delete nav.dataset.scrolled;
    };
    sync();
    window.addEventListener("scroll", sync, { passive: true });
    document.addEventListener("astro:before-swap", () =>
      window.removeEventListener("scroll", sync),
    );
  }
</script>
