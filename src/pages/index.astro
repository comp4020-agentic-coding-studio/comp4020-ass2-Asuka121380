---
// The homepage renders through BaseLayout directly, not ContentLayout: the
// cinematic hero below replaces the theme's default heroImage/heroTitle
// treatment entirely (EditorialHero), so nothing here should trigger the
// theme's own Hero component. Everything from the hero down lives in the
// "Editorial" register (EditorialFrame/EditorialBand) — see
// src/components/home/EditorialFrame.astro for how it relates to the
// lecture pages' "Bench & Booth" register.
import BaseLayout from "astro-theme-university/layouts/BaseLayout.astro";
import heroImage from "../assets/images/hero-guitar-strings.jpg";
import { courseMeta } from "../course-config";
import { siteConfig } from "../site-config";
import EditorialFrame from "../components/home/EditorialFrame.astro";
import EditorialBand from "../components/home/EditorialBand.astro";
import EditorialHero from "../components/home/EditorialHero.astro";
import Philosophy from "../components/home/Philosophy.astro";
import SignalJourney from "../components/home/SignalJourney.astro";
import ToneTimeline from "../components/home/ToneTimeline.astro";
import HearTheDifference from "../components/home/HearTheDifference.astro";
import AssessmentProgression from "../components/home/AssessmentProgression.astro";
import PracticalLinks from "../components/home/PracticalLinks.astro";
---

<BaseLayout
  title={`${courseMeta.code}: ${courseMeta.title}`}
  description={courseMeta.description}
  {...siteConfig}
>
  <EditorialFrame>
    <EditorialHero
      kicker={`${courseMeta.code} · ${courseMeta.session} ${courseMeta.year}`}
      title={courseMeta.title}
      lede="Follow one guitar signal from a plucked string to a listener's ear, one stage at a time — string, pickup, circuit, gain, clipping, filtering, modulation, delay and reverb, amplifier, and speaker. No electronics or DSP background assumed; every week builds its own vocabulary from a waveform or a spectrum, not an adjective."
      tags={courseMeta.tags}
      image={heroImage}
    />

    <EditorialBand tone="dark" label="Course philosophy">
      <p class="editorial-kicker">Why this course reasons the way it does</p>
      <Philosophy />
    </EditorialBand>

    <EditorialBand tone="light" id="signal-journey" label="The signal journey">
      <p class="editorial-kicker">The signal journey</p>
      <h2>String to ear, one signal</h2>
      <SignalJourney />
    </EditorialBand>

    <EditorialBand tone="dark" label="Twelve weeks of tone">
      <p class="editorial-kicker">Twelve weeks of tone</p>
      <h2>Where the semester goes</h2>
      <ToneTimeline />
    </EditorialBand>

    <EditorialBand tone="light" label="Hear the difference">
      <p class="editorial-kicker">Hear the difference</p>
      <h2>Same source, different processing</h2>
      <HearTheDifference />
    </EditorialBand>

    <EditorialBand tone="dark" label="Assessment progression">
      <p class="editorial-kicker">Analyse &rarr; Manipulate &rarr; Design</p>
      <h2>How you are assessed</h2>
      <AssessmentProgression />
    </EditorialBand>

    <EditorialBand tone="light" label="Practical information">
      <p class="editorial-kicker">Getting started</p>
      <h2>Sessions, people, and policies</h2>
      <PracticalLinks />
    </EditorialBand>
  </EditorialFrame>
</BaseLayout>
