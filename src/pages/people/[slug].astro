---
// One person's detail page, in the TONE visual system.
import { render } from "astro:content";
import { Image } from "astro:assets";
import { getPublishedCollection } from "astro-course-university/content";
import BaseLayout from "astro-theme-university/layouts/BaseLayout.astro";
import { withBase } from "astro-theme-university/url";
import { courseMeta } from "../../course-config";
import { siteConfig } from "../../site-config";
import "../../styles/tone.css";

export async function getStaticPaths() {
  const people = await getPublishedCollection("people");
  return people.map((person) => ({ params: { slug: person.id }, props: { person } }));
}

const { person } = Astro.props;
const { Content } = await render(person);

const roleLabels: Record<string, string> = {
  convenor: "Convenor",
  tutor: "Tutor",
  guest: "Guest lecturer",
  other: "",
};
const roleLabel = person.data.role ? roleLabels[person.data.role] : undefined;
const rawPhotoAlt = (person.data as { photoAlt?: unknown }).photoAlt;
const photoAlt = typeof rawPhotoAlt === "string" ? rawPhotoAlt : "";
---

<BaseLayout
  title={`${person.data.title} — ${courseMeta.code}`}
  description={person.data.description}
  mainAttrs={{ "data-tone": true }}
  {...siteConfig}
  name={courseMeta.code}
  logo={undefined}
  logoDark={undefined}
  logoCompact={undefined}
  logoCompactDark={undefined}
>
  <style
    slot="head"
    is:inline
    set:html={`body{--course-title:${JSON.stringify(courseMeta.title)}}`}
  />

  <div class="t-graticule" aria-hidden="true"></div>

  <div class="t-layer">
    <section class="pp-hero t-band">
      <div class="t-shell pp-hero-grid">
        <div>
          <a class="t-link pp-back" href={withBase("/people/")}>
            <span class="t-arrow" aria-hidden="true">&larr;</span> All people
          </a>
          {roleLabel && <p class="t-label t-label--copper">{roleLabel}</p>}
          <h1 class="t-h1 pp-name">{person.data.title}</h1>
          <p class="t-lede pp-desc">{person.data.description}</p>

          <dl class="pp-facts">
            {
              person.data.affiliation && (
                <div>
                  <dt class="t-label">Affiliation</dt>
                  <dd>{person.data.affiliation}</dd>
                </div>
              )
            }
            {
              person.data.email && (
                <div>
                  <dt class="t-label">Email</dt>
                  <dd>
                    <a class="pp-mail" href={`mailto:${person.data.email}`}>{person.data.email}</a>
                  </dd>
                </div>
              )
            }
            {
              person.data.url && (
                <div>
                  <dt class="t-label">Web</dt>
                  <dd>
                    <a class="pp-mail" href={person.data.url}>{person.data.url}</a>
                  </dd>
                </div>
              )
            }
            <div>
              <dt class="t-label">Contact</dt>
              <dd>{person.data.contact}</dd>
            </div>
          </dl>
        </div>

        {
          person.data.photo && (
            <Image
              src={person.data.photo}
              alt={photoAlt}
              width={480}
              height={480}
              format="avif"
              class="pp-photo"
            />
          )
        }
      </div>
    </section>

    <section class="pp-body">
      <div class="t-shell">
        <div class="pp-prose">
          <Content />
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  const nav = document.querySelector<HTMLElement>(".at-nav");
  if (nav) {
    const sync = () => {
      if (window.scrollY > 24) nav.dataset.scrolled = "";
      else delete nav.dataset.scrolled;
    };
    sync();
    window.addEventListener("scroll", sync, { passive: true });
    document.addEventListener("astro:before-swap", () =>
      window.removeEventListener("scroll", sync),
    );
  }
</script>

<style>
  .pp-hero-grid {
    display: grid;
    gap: clamp(2rem, 4vw, 4rem);
    align-items: start;
  }

  .pp-back {
    margin-block-end: 1.75rem;
  }

  .pp-back .t-arrow {
    transition: transform 0.2s ease;
  }

  .pp-back:hover .t-arrow {
    transform: translateX(-0.25rem);
  }

  .pp-name {
    margin: 0.6rem 0 1rem;
  }

  .pp-desc {
    max-width: 46ch;
    margin: 0 0 1.75rem;
  }

  .pp-facts {
    display: grid;
    gap: 1.25rem;
    margin: 0;
  }

  .pp-facts dd {
    margin: 0.3rem 0 0;
    color: var(--t-paper);
  }

  .pp-mail {
    color: var(--t-signal);
  }

  .pp-photo {
    width: 100%;
    max-width: 20rem;
    aspect-ratio: 1;
    object-fit: cover;
    filter: saturate(0.9);
    justify-self: start;
  }

  .pp-body {
    padding-block-end: clamp(4rem, 8vw, 6rem);
  }

  .pp-prose {
    max-width: var(--t-measure);
    color: var(--t-dim);
  }

  .pp-prose :global(p) {
    font-size: var(--t-body);
    line-height: 1.65;
    margin: 0 0 1.25rem;
  }

  .pp-prose :global(strong) {
    color: var(--t-paper);
    font-weight: 600;
  }

  @media (min-width: 55rem) {
    .pp-hero-grid {
      grid-template-columns: 1.4fr 1fr;
    }

    .pp-photo {
      justify-self: end;
    }
  }
</style>
