---
// People, in the TONE visual system. Four large editorial rows rather than a
// card grid or a compressed roster — the theme's Card/CardGrid are exactly
// the "identical box per item" pattern the system exists to avoid, and with
// only four people a roster row under-uses the space a real portrait earns.
// Rows alternate photo-left/text-right and text-left/photo-right so the page
// reads as a sequence of introductions, not a repeated template.
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { getPublishedCollection } from "astro-course-university/content";
import BaseLayout from "astro-theme-university/layouts/BaseLayout.astro";
import { withBase } from "astro-theme-university/url";
import PortraitCaption from "../../components/tone/PortraitCaption.astro";
import { courseMeta } from "../../course-config";
import { siteConfig } from "../../site-config";
import "../../styles/tone.css";

const roleLabels: Record<string, string> = {
  convenor: "Convenor",
  tutor: "Tutor",
  guest: "Guest lecturer",
  other: "",
};

// Not week order, not alphabetical — the sequence the plan asked for, so the
// photo-left/text-left alternation lands on a deliberate pair rather than
// whatever a collection sort happens to produce.
const ORDER = ["jimi-hendrix", "john-mayer", "eric-clapton", "stevie-ray-vaughan"];

const PORTRAIT_CREDIT: Record<string, string> = {
  "jimi-hendrix": "Photo: e24.se / Scanpix · Public domain",
  "john-mayer": "Photo: Thatcommonkid · CC BY-SA 4.0",
  "eric-clapton": "Photo: Stoned59 · CC BY 2.0",
  "stevie-ray-vaughan": "Photo: Don Hunstein · Public domain",
};

// Each photo is a real, differently-framed photograph, not a uniform
// illustrated avatar. Astro's image service resizes/crops to the target box
// at build time (sharp `cover`, centred by default) *before* any CSS ever
// sees the file, so the crop has to be steered with the `<Image>` `position`
// prop (passed straight through to sharp's `resize` `position`, which only
// understands its own keyword set — not arbitrary CSS percentages) rather
// than a CSS `object-position` style, which has nothing left to reposition
// once the file is already cropped to the box's aspect ratio. Hendrix and
// Vaughan are tall, tightly-cropped originals where a centred crop loses the
// face entirely, so both pin to "top"; Mayer and Clapton's crops stay
// centred (the sharp default) without needing an override.
const PORTRAIT_POSITION: Record<string, string> = {
  "jimi-hendrix": "top",
  "stevie-ray-vaughan": "top",
};

function photoAlt(data: unknown): string | undefined {
  const alt = (data as { photoAlt?: unknown }).photoAlt;
  return typeof alt === "string" ? alt : undefined;
}

const allPeople = await getPublishedCollection("people");
const byId = new Map(allPeople.map((person) => [person.id, person]));
const people = ORDER.map((id) => byId.get(id)).filter(
  (person): person is CollectionEntry<"people"> => Boolean(person),
);
---

<BaseLayout
  title={`People — ${courseMeta.code}`}
  description="Who teaches SLOP2186, and how to reach them."
  mainAttrs={{ "data-tone": true }}
  {...siteConfig}
  name={courseMeta.code}
  logo={undefined}
  logoDark={undefined}
  logoCompact={undefined}
  logoCompactDark={undefined}
>
  <style
    slot="head"
    is:inline
    set:html={`body{--course-title:${JSON.stringify(courseMeta.title)}}`}
  />

  <div class="t-graticule" aria-hidden="true"></div>

  <div class="t-layer">
    <section class="p-hero t-band">
      <div class="t-shell">
        <p class="t-label t-label--signal">Teaching team</p>
        <h1 class="t-h1 p-hero-title">People</h1>
        <p class="t-lede p-hero-lede">Who teaches {courseMeta.code}, and how to reach them.</p>
      </div>
    </section>

    <section class="p-rows" aria-labelledby="p-rows-heading">
      <h2 class="visually-hidden" id="p-rows-heading">Teaching team</h2>
      <div class="t-shell">
        <ul class="p-row-list" role="list">
          {
            people.map((person, index) => {
              const photoLeft = index % 2 === 0;
              const roleLabel = person.data.role ? roleLabels[person.data.role] : undefined;
              const href = withBase(`/people/${person.id}/`);
              return (
                <li class="t-rule">
                  <div
                    class="t-grid p-row"
                    class:list={{ "p-row--photo-left": photoLeft, "p-row--text-left": !photoLeft }}
                  >
                    <figure class="p-row-photo">
                      {person.data.photo && (
                        <Image
                          src={person.data.photo}
                          alt={photoAlt(person.data) ?? ""}
                          width={640}
                          height={800}
                          format="avif"
                          class="p-row-img"
                          position={PORTRAIT_POSITION[person.id] ?? "center"}
                        />
                      )}
                      <PortraitCaption credit={PORTRAIT_CREDIT[person.id]} />
                    </figure>

                    <div class="p-row-copy">
                      {roleLabel && <p class="t-label p-row-role">{roleLabel}</p>}
                      <h3 class="t-h2 p-row-name">
                        <a class="p-row-link" href={href}>
                          {person.data.title}
                        </a>
                      </h3>
                      <p class="t-body p-row-desc">{person.data.description}</p>
                      <dl class="p-row-facts">
                        {person.data.affiliation && (
                          <div>
                            <dt class="t-label">Affiliation</dt>
                            <dd>{person.data.affiliation}</dd>
                          </div>
                        )}
                        {person.data.email && (
                          <div>
                            <dt class="t-label">Email</dt>
                            <dd>
                              <a class="p-row-mail" href={`mailto:${person.data.email}`}>
                                {person.data.email}
                              </a>
                            </dd>
                          </div>
                        )}
                      </dl>
                      <a class="t-link p-row-more" href={href}>
                        Full profile <span class="t-arrow" aria-hidden="true">&rarr;</span>
                      </a>
                    </div>
                  </div>
                </li>
              );
            })
          }
        </ul>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  const nav = document.querySelector<HTMLElement>(".at-nav");
  if (nav) {
    const sync = () => {
      if (window.scrollY > 24) nav.dataset.scrolled = "";
      else delete nav.dataset.scrolled;
    };
    sync();
    window.addEventListener("scroll", sync, { passive: true });
    document.addEventListener("astro:before-swap", () =>
      window.removeEventListener("scroll", sync),
    );
  }
</script>

<style>
  .p-hero-title {
    margin: 0.75rem 0 1.25rem;
  }

  .p-rows {
    padding-block-end: clamp(4rem, 8vw, 6rem);
  }

  .p-row-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .p-row-list > li {
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
  }

  .p-row-list > li:last-child {
    border-block-end: 1px solid var(--t-line);
  }

  .p-row {
    align-items: center;
    row-gap: 2rem;
  }

  .p-row-photo {
    margin: 0;
  }

  .p-row-img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    filter: saturate(0.9);
  }

  .p-row-copy {
    display: grid;
    gap: 0.9rem;
    align-content: center;
  }

  .p-row-role {
    color: var(--t-copper);
  }

  .p-row-name {
    margin: 0;
  }

  .p-row-link {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .p-row-link:hover,
  .p-row-link:focus-visible {
    color: var(--t-signal);
  }

  .p-row-desc {
    max-width: 46ch;
  }

  .p-row-facts {
    display: grid;
    gap: 0.75rem;
    margin: 0.4rem 0 0;
  }

  .p-row-facts dd {
    margin: 0.25rem 0 0;
    color: var(--t-paper);
  }

  .p-row-mail {
    color: var(--t-signal);
  }

  .p-row-more {
    margin-block-start: 0.4rem;
  }

  .p-row-more .t-arrow {
    transition: transform 0.2s ease;
  }

  .p-row-more:hover .t-arrow,
  .p-row-more:focus-visible .t-arrow {
    transform: translateX(0.3rem);
  }

  @media (width >= 60rem) {
    .p-row--photo-left .p-row-photo {
      grid-column: 1 / span 5;
    }

    .p-row--photo-left .p-row-copy {
      grid-column: 7 / span 6;
    }

    .p-row--text-left .p-row-copy {
      grid-column: 1 / span 6;
    }

    .p-row--text-left .p-row-photo {
      grid-column: 8 / span 5;
    }
  }
</style>
